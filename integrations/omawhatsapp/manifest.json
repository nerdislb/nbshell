{
  "schemaVersion": 2,
  "id": "omawhatsapp",
  "name": "WhatsApp",
  "version": "0.8.2-nbshell.1",
  "author": "MoizIbnYousaf; nbshell port by nerdi",
  "license": "MIT",
  "repository": "https://github.com/MoizIbnYousaf/Omarchy-Whatsapp",
  "dependencies": {
    "commands": ["python3", "wacli", "wl-copy", "wl-paste", "zenity", "inotifywait", "jq"],
    "packages": ["python", "wl-clipboard", "zenity", "inotify-tools", "jq", "qt6-multimedia", "qt6-imageformats"]
  },
  "description": "Native local-first WhatsApp client powered by wacli, ported for nbshell.",
  "category": "Communication",
  "kinds": ["service", "bar-widget"],
  "activation": "on-demand",
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "WhatsApp",
    "description": "Local WhatsApp chats and unread messages.",
    "category": "Communication",
    "aliases": ["whatsapp", "chat", "messages"],
    "allowMultiple": false,
    "defaultSection": "left"
  }
}

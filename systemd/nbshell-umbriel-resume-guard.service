[Unit]
Description=Repair Umbriel workspace assignments after suspend
Documentation=https://github.com/nerdislb/nbshell
PartOf=graphical-session.target
After=graphical-session.target
ConditionEnvironment=UMBRIEL_SOCKET

[Service]
Type=simple
Slice=session.slice
ExecStart=%h/.config/quickshell/nbshell/scripts/umbriel_resume_guard.py
Restart=on-failure
RestartSec=2
Environment=PYTHONDONTWRITEBYTECODE=1
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=graphical-session.target

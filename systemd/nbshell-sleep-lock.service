[Unit]
Description=Lock the nbshell session before system sleep
Documentation=https://github.com/nerdislb/nbshell
PartOf=graphical-session.target
After=graphical-session.target nbshell.service
Requisite=graphical-session.target

[Service]
Type=simple
Slice=session.slice
ExecStart=%h/.config/quickshell/nbshell/scripts/sleep_lock_inhibitor.py
Restart=on-failure
RestartSec=2
Environment=PYTHONDONTWRITEBYTECODE=1
Environment="NBSHELL_LOCK_READY=%t/nbshell-lock-ready"
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectControlGroups=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX
UMask=0077

[Install]
WantedBy=graphical-session.target

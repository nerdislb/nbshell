// Eigenstaendige nbshell-Tastenkuerzel. `nbshell switch on` bindet diese
// Datei in niris config.kdl ein; `switch off` entfernt den Include wieder.
include "nbshell-outputs.kdl"
//
// Der Sperrbildschirm (Mod+Alt+L) zeigt auf `nbshell power lock`. nbshell
// erzeugt dafuer eine Theme-Konfiguration; Hyprlock/PAM bleibt der eigentliche
// Sicherheitsmechanismus. Ein eigener `lockCommand` bleibt als Override
// moeglich.
// Aufgerufen wird ueber `sh -c "$HOME/.local/bin/nbshell …"`: niri startet
// spawn-Befehle mit dem PATH des systemd-User-Managers, in dem ~/.local/bin
// nicht steht. Ein blosses `spawn "nbshell"` laeuft still ins Leere.
binds {
    // Wie Omarchy 4: Super+Space ist der zentrale Einstieg. Apps liegen eine
    // Alt-Ebene daneben; Mod+Shift+Space bleibt als vertrauter Alias erhalten.
    Mod+Space hotkey-overlay-title="nbshell: Menu" { spawn "sh" "-c" "$HOME/.local/bin/nbshell menu"; }
    Mod+Alt+Space hotkey-overlay-title="nbshell: Application launcher" { spawn "sh" "-c" "$HOME/.local/bin/nbshell launcher"; }

    // Das Menue -- ein verschachtelter Sammelpunkt (Stil, Aufnahme, System,
    // Verbindungen, Extras), wie Omarchys Menue. Die Befehlspalette lebt weiter
    // im Starter (Mod+Space, dann ">"), sie brauchte kein eigenes Kuerzel mehr.
    Mod+Shift+Space hotkey-overlay-title="nbshell: Menu" { spawn "sh" "-c" "$HOME/.local/bin/nbshell menu"; }
    Mod+BackSpace hotkey-overlay-title="nbshell: Toggle grid-scroll layout" { spawn "sh" "-c" "$HOME/.local/bin/nbshell grid toggle"; }

    // Omarchys Super+Ctrl-E/C/H/A-Schema: eigenstaendige Shell-Oberflaechen
    // liegen gemeinsam auf der Ctrl-Ebene und sind dadurch leicht merkbar.
    Mod+Ctrl+E hotkey-overlay-title="nbshell: Emoji" { spawn "sh" "-c" "$HOME/.local/bin/nbshell emoji"; }
    Mod+Ctrl+T hotkey-overlay-title="nbshell: Quick Translate" { spawn "sh" "-c" "$HOME/.local/bin/nbshell translate"; }
    Mod+Ctrl+C hotkey-overlay-title="nbshell: Capture" { spawn "sh" "-c" "$HOME/.local/bin/nbshell capture"; }
    Mod+Ctrl+H hotkey-overlay-title="nbshell: System & Plugins" { spawn "sh" "-c" "$HOME/.local/bin/nbshell hub"; }
    Mod+Ctrl+M hotkey-overlay-title="nbshell: Arrange modules" { spawn "sh" "-c" "$HOME/.local/bin/nbshell modules"; }
    Mod+Ctrl+P hotkey-overlay-title="nbshell: Plugin diagnostics" { spawn "sh" "-c" "$HOME/.local/bin/nbshell plugin-dev"; }
    Mod+Ctrl+A hotkey-overlay-title="nbshell: Audio" { spawn "sh" "-c" "$HOME/.local/bin/nbshell audio panel"; }
    Mod+Shift+A hotkey-overlay-title="nbshell: Quick Agent" { spawn "sh" "-c" "$HOME/.local/bin/nbshell agent quick"; }
    Mod+Ctrl+Shift+A hotkey-overlay-title="nbshell: Agent Center" { spawn "sh" "-c" "$HOME/.local/bin/nbshell agent center"; }
    Mod+Alt+A hotkey-overlay-title="nbshell: Focus & Equalizer" { spawn "sh" "-c" "$HOME/.local/bin/nbshell audio tools"; }
    Mod+Escape hotkey-overlay-title="nbshell: Session" { spawn "sh" "-c" "$HOME/.local/bin/nbshell power menu"; }

    // Benachrichtigungsarchiv.
    Mod+N hotkey-overlay-title="nbshell: Notifications" { spawn "sh" "-c" "$HOME/.local/bin/nbshell notify center"; }

    // Hintergrund-Karussell.
    Mod+Y hotkey-overlay-title="nbshell: Wallpaper" { spawn "sh" "-c" "$HOME/.local/bin/nbshell wallpaper pick"; }

    // Kein DMS-Erbe, sondern neu: die Aufgabenliste. Mod+T war als einzige
    // Buchstabentaste noch frei.
    Mod+T hotkey-overlay-title="nbshell: Tasks" { spawn "sh" "-c" "$HOME/.local/bin/nbshell todo toggle"; }

    // Der jeweils aktive MPRIS-Player: Browser, PrettyZap, mpv oder eine
    // andere Medien-App. P wie Player; Mod+M ist bereits die Prozessliste.
    Mod+P hotkey-overlay-title="nbshell: Media" { spawn "sh" "-c" "$HOME/.local/bin/nbshell dashboard view media"; }
    Mod+Ctrl+Shift+G hotkey-overlay-title="nbshell: Mail" { spawn "sh" "-c" "$HOME/.local/bin/nbshell extension toggle omamail"; }
    Mod+Ctrl+Shift+M hotkey-overlay-title="nbshell: YouTube Music" { spawn "sh" "-c" "$HOME/.local/bin/nbshell extension toggle ytmusic"; }

    // Zen erzeugt das echte Videofenster mit Ctrl+Shift+]. Danach steuert
    // nbshell dessen Geometrie, ohne Browser- oder DRM-Inhalt anzufassen.
    Mod+Alt+P hotkey-overlay-title="nbshell: PiP size" { spawn "sh" "-c" "$HOME/.local/bin/nbshell pip size"; }
    Mod+Alt+Shift+P hotkey-overlay-title="nbshell: PiP corner" { spawn "sh" "-c" "$HOME/.local/bin/nbshell pip corner"; }

    // Ton zurueck auf die Bluetooth-Hoerer, wenn sie beim Telefon geblieben
    // sind. Z war frei und liegt neben der linken Hand.
    Mod+Z hotkey-overlay-title="nbshell: Restore audio" { spawn "sh" "-c" "$HOME/.local/bin/nbshell audio-restore"; }

    // Die Tastenuebersicht. K war NICHT frei: dms/binds.kdl legt darauf
    // `focus-window-up` (die vim-Reihe H/J/K/L). Diese Datei wird spaeter
    // eingebunden und gewinnt deshalb -- gewollt, aber erwaehnenswert. Nach
    // oben kommt man weiterhin mit Mod+Pfeil-hoch.
    Mod+K hotkey-overlay-title="nbshell: Key bindings" { spawn "sh" "-c" "$HOME/.local/bin/nbshell keys"; }

    // Optionsmenue.
    Mod+Comma hotkey-overlay-title="nbshell: Settings" { spawn "sh" "-c" "$HOME/.local/bin/nbshell settings"; }

    // Zwischenablageverlauf.
    Mod+V hotkey-overlay-title="nbshell: Clipboard" { spawn "sh" "-c" "$HOME/.local/bin/nbshell clip toggle"; }

    // Sitzungsmenue.
    Super+X hotkey-overlay-title="nbshell: Session" { spawn "sh" "-c" "$HOME/.local/bin/nbshell power menu"; }

    // Prozessliste.
    Mod+M hotkey-overlay-title="nbshell: Processes" { spawn "sh" "-c" "$HOME/.local/bin/nbshell procs"; }
    Ctrl+Alt+Delete hotkey-overlay-title="nbshell: Processes" { spawn "sh" "-c" "$HOME/.local/bin/nbshell procs"; }

    // Aufnahme-Menue (Region/Bildschirm/Fenster/OCR/Aufnahme).
    Print hotkey-overlay-title="nbshell: Capture" { spawn "sh" "-c" "$HOME/.local/bin/nbshell capture"; }
    F9 hotkey-overlay-title="nbshell: Toggle dictation" { spawn "sh" "-c" "$HOME/.local/bin/nbshell dictate"; }

    // Theme-synchroner Hyprlock-Sperrbildschirm.
    // Auch auf niris rotem Sicherheitsbildschirm erneut ausloesbar, falls der
    // Locker unerwartet beendet wurde. Die Sitzung selbst bleibt dabei zu.
    Mod+Alt+L allow-when-locked=true hotkey-overlay-title="nbshell: Lock" { spawn "sh" "-c" "$HOME/.local/bin/nbshell power lock"; }

    // Helligkeitsdienst.
    XF86MonBrightnessUp   allow-when-locked=true { spawn "sh" "-c" "$HOME/.local/bin/nbshell brightness up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "$HOME/.local/bin/nbshell brightness down"; }

    // MPRIS-Anbindung.
    XF86AudioPlay  allow-when-locked=true { spawn "sh" "-c" "$HOME/.local/bin/nbshell media playpause"; }
    XF86AudioPause allow-when-locked=true { spawn "sh" "-c" "$HOME/.local/bin/nbshell media playpause"; }
    XF86AudioNext  allow-when-locked=true { spawn "sh" "-c" "$HOME/.local/bin/nbshell media next"; }
    XF86AudioPrev  allow-when-locked=true { spawn "sh" "-c" "$HOME/.local/bin/nbshell media previous"; }
}

// Der Bildschirmschoner: bildschirmfuellend, ohne Rahmen, ohne Schatten.
//
// Erkannt am TITEL, nicht an der App-Kennung: ghostty vergibt die fest
// (`com.mitchellh.ghostty`), und `--class` aendert daran nichts. Den Titel
// setzt das Skript selbst per Escape-Sequenz -- das geht mit jedem Terminal.
window-rule {
    match title="nbshell-screensaver"
    open-fullscreen true
    open-focused true
    border { off; }
    shadow { off; }
}

// Gaming setup is deliberately visible in a terminal. Keep that confirmation
// window compact and above the desktop while package managers are running.
window-rule {
    match title="nbshell-gaming"
    open-floating true
    open-focused true
    default-column-width { proportion 0.64; }
    default-window-height { proportion 0.72; }
}

// Zens natives Videofenster soll sofort ueber dem Tiling schweben. Die
// Feingeometrie uebernimmt zen-pip.py, sobald das Fenster erscheint.
window-rule {
    match app-id="zen" title="^(Picture-in-Picture|Bild-im-Bild)$"
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// Das schmale Pixel-Hochformat darf keine breite Tiling-Spalte erben.
// Floating respektiert scrcpys eigenes Seitenverhaeltnis und legt den
// Niri-Rahmen damit direkt um den sichtbaren Smartphone-Ausschnitt.
window-rule {
    match app-id="scrcpy" title="^Pixel 9 Pro · nbphone$"
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// The focused, floating trimmer is part of the capture workflow rather than
// a normal tiled editing workspace.
window-rule {
    match app-id="omacut"
    open-floating true
    open-focused true
    default-column-width { proportion 0.62; }
    default-window-height { proportion 0.72; }
}

// Low-latency preview for the phone webcam. It reads the same V4L2 device as
// OBS and stays floating so framing can be checked without changing layouts.
window-rule {
    match app-id="mpv" title="^Phone Camera Preview$"
    open-floating true
    open-focused true
    default-column-width { proportion 0.48; }
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// All agents launched through `nbshell agent` share a predictable prefix.
// They remain tiled like normal development terminals; the rule only makes
// them recognizable to Niri and future session/focus integrations.
window-rule {
    match app-id=r"^dev\.nerdi\.nbshell\.agent\..*$"
    open-focused true
}

// Super+Shift+A is the immediate customization path: the preferred agent
// opens as a focused floating terminal while normal development agents stay
// tiled. The app-id is assigned only by `nbshell agent quick`.
window-rule {
    match app-id=r"^dev\.nerdi\.nbshell\.agent\.quick\..*$"
    open-floating true
    open-focused true
    default-column-width { proportion 0.64; }
    default-window-height { proportion 0.72; }
}

window-rule {
    match title="^(Omamail|YouTube Music|Pit Wall)$"
    open-floating true
    open-focused true
    default-column-width { proportion 0.72; }
    default-window-height { proportion 0.78; }
}

// Die weichgezeichnete Kopie des Hintergrunds gehoert in niris Backdrop --
// dann zeigt die Uebersicht (Mod+Tab) sie statt einer leeren Flaeche.
// Weichzeichnen kann niri nicht selbst; nbshell haelt die Kopie bereit.
layer-rule {
    match namespace="nbshell:wallpaper-blur"
    place-within-backdrop true
}

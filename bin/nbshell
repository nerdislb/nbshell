#!/usr/bin/env bash
# nbshell -- Startet und steuert die Shell.
#
# Duenne Huelle um `qs -c nbshell`. Alles, was nicht als Unterbefehl bekannt
# ist, wandert unveraendert an Quickshell weiter.
set -euo pipefail

CONFIG_NAME="nbshell"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nbshell"
THEME_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/theme-install.sh"

qs_bin() {
    if command -v qs >/dev/null 2>&1; then echo qs; else echo quickshell; fi
}

QS="$(qs_bin)"

ipc() {
    "$QS" -c "$CONFIG_NAME" ipc call "$@"
}

# ── Umschalten zwischen DMS und nbshell ──────────────────────────────────
#
# Drei Dinge gehoeren zusammen, sonst ist der Zustand halb:
#   1. dms.service  -- die Unit ist Type=dbus auf org.freedesktop.Notifications
#                      und wird nie "active", wenn nbshell den Namen hat.
#   2. der Benachrichtigungsserver in nbshell.
#   3. die Tastenkuerzel, die bisher DMS gehoerten.
NIRI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
UNIT_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/niri.service.d/nbshell.conf"
GHOSTTY="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config"
TAKEOVER="nbshell-takeover.kdl"
COLORS="nbshell-colors.kdl"
INCLUDE_LINE="include \"$TAKEOVER\""
COLORS_LINE="include \"$COLORS\""

niri_include() {
    local cfg="$NIRI_DIR/config.kdl"
    [ -f "$cfg" ] || { echo "niri-Config nicht gefunden: $cfg" >&2; return 1; }
    grep -qF "$INCLUDE_LINE" "$cfg" && return 0
    cp "$cfg" "$cfg.vor-nbshell"
    # Die Farbdatei zuerst schreiben lassen -- ein include auf eine fehlende
    # Datei macht die ganze Config ungueltig.
    ipc theme write >/dev/null 2>&1 || true
    printf '\n// nbshell uebernimmt DMS-Tastenkuerzel und faerbt die Fensterrahmen\n// (nbshell switch off entfernt beides)\n%s\n' "$INCLUDE_LINE" >> "$cfg"
    [ -f "$NIRI_DIR/$COLORS" ] && printf '%s\n' "$COLORS_LINE" >> "$cfg"
    if ! niri validate >/dev/null 2>&1; then
        mv "$cfg.vor-nbshell" "$cfg"
        echo "niri-Config waere ungueltig geworden -- zurueckgenommen." >&2
        return 1
    fi
    echo "  niri:   $INCLUDE_LINE eingetragen (Sicherung: config.kdl.vor-nbshell)"
}

niri_exclude() {
    local cfg="$NIRI_DIR/config.kdl"
    grep -qF "$INCLUDE_LINE" "$cfg" || return 0
    cp "$cfg" "$cfg.vor-nbshell"
    grep -vF "$INCLUDE_LINE" "$cfg" | grep -vF "$COLORS_LINE" | grep -v "^// nbshell uebernimmt DMS-Tastenkuerzel" | grep -v "^// (nbshell switch off entfernt beides)" > "$cfg.neu"
    mv "$cfg.neu" "$cfg"
    niri validate >/dev/null 2>&1 || { mv "$cfg.vor-nbshell" "$cfg"; echo "zurueckgenommen." >&2; return 1; }
    echo "  niri:   $INCLUDE_LINE entfernt"
}

# ghostty liest genau EINE Themedatei. Solange DMS laeuft, schreibt matugen
# `dankcolors`; danach schreibt nbshell `nbcolors` bei jedem Themewechsel.
# Umgebogen wird nur die eine Zeile, mit Sicherung daneben.
ghostty_theme() {
    local want="$1"
    [ -f "$GHOSTTY" ] || return 0
    grep -q "^theme = $want\$" "$GHOSTTY" && return 0
    cp "$GHOSTTY" "$GHOSTTY.vor-nbshell"
    sed -i "s/^theme = .*/theme = $want/" "$GHOSTTY"
    echo "  ghostty: theme = $want (Sicherung: config.vor-nbshell)"
}

# Damit nbshell nach dem Anmelden von selbst da ist. Dasselbe Muster, das DMS
# benutzt: ein Drop-in an niri.service, das die Unit mitzieht. Eine EIGENE
# Datei -- dms.conf bleibt unangetastet, damit der Rueckweg frei bleibt.
autostart_on() {
    mkdir -p "$(dirname "$UNIT_DROPIN")"
    printf '[Unit]\nWants=nbshell.service\n' > "$UNIT_DROPIN"
    systemctl --user daemon-reload 2>/dev/null
    systemctl --user enable nbshell.service >/dev/null 2>&1
    # Laeuft schon eine von Hand gestartete Instanz, uebernimmt sie die Unit
    # nicht -- also einmal sauber neu.
    "$QS" -c nbshell kill >/dev/null 2>&1 || true
    sleep 0.3
    systemctl --user restart nbshell.service 2>/dev/null && echo "  nbshell: startet ab jetzt beim Anmelden mit"
}

autostart_off() {
    rm -f "$UNIT_DROPIN"
    systemctl --user disable nbshell.service >/dev/null 2>&1
    systemctl --user daemon-reload 2>/dev/null
    echo "  nbshell: startet nicht mehr automatisch (laeuft weiter)"
}

switch_on() {
    echo "nbshell uebernimmt:"
    if [ ! -f "$NIRI_DIR/$TAKEOVER" ]; then
        echo "  $TAKEOVER fehlt -- erst ./install.sh laufen lassen." >&2
        return 1
    fi
    systemctl --user stop dms.service 2>/dev/null && echo "  dms:    gestoppt"
    # `dms run` beendet sich mit 143 (SIGTERM). Die Unit hat dafuer kein
    # SuccessExitStatus, systemd merkt sie sich also als "failed" -- und sie
    # taucht auf ewig in `systemctl --user --failed` auf. Einmal quittieren.
    systemctl --user reset-failed dms.service 2>/dev/null || true
    # `disable` hilft hier NICHT: DMS haengt ueber ein Drop-in an niri.service
    # (~/.config/systemd/user/niri.service.d/dms.conf, "Wants=dms.service"),
    # kommt also bei jeder Anmeldung wieder. Nur `mask` haelt es dauerhaft weg
    # -- und das nur auf ausdrueckliche Ansage.
    if [ "${1:-}" = "dauerhaft" ]; then
        systemctl --user mask dms.service >/dev/null 2>&1 && echo "  dms:    maskiert, bleibt auch nach dem Anmelden weg"
    else
        echo "  dms:    kommt bei der naechsten Anmeldung wieder"
        echo "          (dauerhaft weg: nbshell switch on dauerhaft)"
    fi
    niri_include || true
    ipc notify server on >/dev/null && echo "  nbshell: Benachrichtigungsserver an"
    # Ohne DMS malt niemand mehr den Hintergrund -- sonst steht man vor einer
    # schwarzen Flaeche und sucht den Fehler bei sich.
    ipc wallpaper on >/dev/null && echo "  nbshell: Hintergrundbild an"
    ghostty_theme nbcolors
    autostart_on
    echo
    echo "Mit DMS gehen auch dessen Plugins -- nbshell hat fuer jedes einen"
    echo "Ersatz: Insel, Arbeitsflaechen, Themewahl, Aufnahme, KI-Verbrauch."
    echo "Tot bleiben Mod+Comma, Mod+Y und Mod+Shift+N -- siehe $TAKEOVER."
}

switch_off() {
    echo "DMS uebernimmt wieder:"
    ipc notify server off >/dev/null && echo "  nbshell: Benachrichtigungsserver aus"
    ipc wallpaper off >/dev/null && echo "  nbshell: Hintergrundbild aus (DMS malt wieder)"
    ghostty_theme dankcolors
    autostart_off
    niri_exclude || true
    systemctl --user unmask dms.service >/dev/null 2>&1
    systemctl --user start dms.service 2>/dev/null && echo "  dms:    gestartet"
}

switch_status() {
    printf 'dms.service      %s\n' "$(systemctl --user is-active dms.service 2>/dev/null; systemctl --user is-enabled dms.service 2>/dev/null | tr '\n' ' ')"
    printf 'Benachrichtigung %s\n' "$(busctl --user list 2>/dev/null | awk '/^org.freedesktop.Notifications/ {print $2" ("$3")"}')"
    printf 'niri-Binds       %s\n' "$(grep -qF "$INCLUDE_LINE" "$NIRI_DIR/config.kdl" && echo "nbshell" || echo "DMS")"
    printf 'Fensterrahmen    %s\n' "$(grep -qF "$COLORS_LINE" "$NIRI_DIR/config.kdl" && echo "nbshell" || echo "DMS")"
    printf 'nbshell-Autostart %s\n' "$([ -f "$UNIT_DROPIN" ] && echo "an ($(systemctl --user is-active nbshell.service))" || echo "aus")"
}

usage() {
    cat <<'USAGE'
nbshell -- eigene Shell auf Quickshell

  nbshell start [-d]        startet die Shell (-d loest sie vom Terminal)
  nbshell stop              beendet sie
  nbshell restart

  nbshell bar               durchgehender Balken
  nbshell island            freistehende Insel
  nbshell mode toggle       zwischen beidem wechseln
  nbshell edge top|bottom|toggle
  nbshell open|close|toggle Insel festhalten (unabhaengig von der Maus)

  nbshell theme             zeigt das aktuelle Theme
  nbshell theme <name>      wechselt es
  nbshell themes            listet die vorhandenen
  nbshell theme install <url|verzeichnis>
                            Omarchy-Theme dazuholen (auch ohne colors.toml:
                            die Palette wird aus alacritty.toml abgeleitet)
  nbshell theme remove <name>
  nbshell theme update      selbst installierte Themes aktualisieren
  nbshell picker            Themewahl aufklappen
  nbshell next | prev       ein Theme weiter/zurueck

  nbshell audio up|down     Lautstaerke (fuer die Multimediatasten)
  nbshell audio mute        stumm schalten
  nbshell audio <prozent>   fest einstellen
  nbshell audio status
  nbshell audio panel       Regler und Geraeteliste aufklappen

  nbshell launcher          Anwendungsstarter (Alias: run)
  nbshell find <text>       zeigt, was der Starter finden wuerde

  nbshell notify            Stand der Benachrichtigungen
  nbshell notify toggle     Archiv aufklappen
  nbshell notify dnd        "nicht stoeren" umschalten
  nbshell notify clear
  nbshell notify server on|off
                            uebernimmt org.freedesktop.Notifications von DMS
                            (dessen Unit muss dann gestoppt sein)

  nbshell modules           Bausteine der Leiste anordnen
  nbshell settings          Optionsmenue (Rand, Form, Optik, Schalter)
  nbshell updates           Updates: status, check, list, run
  nbshell ai                KI-Verbrauch (auch: refresh)
  nbshell capture           Aufnahme-Menue (screen, window, region, ocr, record)
  nbshell procs             Prozessliste (auch: top)
  nbshell clip              Verlauf der Zwischenablage (toggle, list, clear)
  nbshell power             Power-Menue (auch: lock, logout, suspend)
  nbshell media playpause|next|previous|status

  nbshell tray              zeigt, was im Tray steckt
  nbshell tray toggle       Symbole ein- und ausklappen
  nbshell osd test|on|off   Einblendung beim Regeln
  nbshell control           Control Center (Helligkeit, WLAN, Bluetooth)
  nbshell brightness up|down|<prozent>

  nbshell wallpaper on|off  Hintergrundbild des Themes (aus, solange DMS laeuft)
  nbshell wallpaper pick    Karussell: Bilder des Themes durchblaettern
  nbshell wallpaper list
  nbshell wallpaper <pfad>  festes Bild statt des Themebildes

  nbshell get <key>         Wert aus der Config
  nbshell set <key> <wert>  Wert setzen (JSON erlaubt: 12, true, ["a","b"])
  nbshell config            zeigt die ganze Config
  nbshell state             was gerade offen ist
  nbshell status

  nbshell switch on [dauerhaft]
                            DMS weicht: Unit aus, Benachrichtigungen und
                            Tastenkuerzel zu nbshell
  nbshell switch off        alles zurueck zu DMS
  nbshell switch status

Alles andere geht unveraendert an Quickshell:
  nbshell log, nbshell ipc show, ...
USAGE
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    ""|-h|--help|help)
        usage
        ;;
    start)
        exec "$QS" -c "$CONFIG_NAME" "$@"
        ;;
    stop)
        exec "$QS" -c "$CONFIG_NAME" kill
        ;;
    restart)
        "$QS" -c "$CONFIG_NAME" kill 2>/dev/null || true
        sleep 0.3
        exec "$QS" -c "$CONFIG_NAME" -d
        ;;
    bar|island)
        ipc bar mode "$cmd" >/dev/null && echo "$cmd"
        ;;
    mode|edge)
        ipc bar "$cmd" "${1:-toggle}"
        ;;
    open|close|toggle)
        ipc bar "$cmd"
        ;;
    theme)
        case "${1:-}" in
            # `current` MUSS hier stehen: sonst landet es im Zweig darunter
            # und setzt das Theme auf den Namen "current".
            ""|current) ipc theme current ;;
            install|remove|update|list)
                # Nach dem Installieren die Liste neu einlesen, sonst taucht
                # das Theme erst nach einem Neustart in der Auswahl auf.
                "$THEME_TOOL" "$@" && ipc themes reload >/dev/null 2>&1
                ;;
            write) ipc theme write ;;
            *) ipc theme set "$1" ;;
        esac
        ;;
    themes)
        # Aus der laufenden Shell, damit der Stern stimmt; ohne sie vom Datei-
        # system.
        if ! ipc themes list 2>/dev/null; then
            for d in "$CONFIG_DIR"/themes/*/; do printf '   %s\n' "$(basename "$d")"; done
        fi
        ;;
    picker)
        ipc themes toggle
        ;;
    audio)
        case "${1:-status}" in
            up|down|mute|micmute|status|panel) ipc audio "${1:-status}" ;;
            *) ipc audio set "$1" ;;
        esac
        ;;
    launcher|run)
        ipc launcher "${1:-toggle}"
        ;;
    find)
        ipc launcher find "${1:?Suchbegriff fehlt}"
        ;;
    switch)
        case "${1:-status}" in
            on) shift; switch_on "$@" ;;
            off) switch_off ;;
            *) switch_status ;;
        esac
        ;;
    state)
        ipc state dump
        ;;
    settings)
        ipc settings toggle
        ;;
    modules)
        ipc settings modules
        ;;
    updates)
        ipc updates "${1:-status}"
        ;;
    ai)
        ipc ai "${1:-status}"
        ;;
    capture)
        ipc capture "${1:-menu}"
        ;;
    procs|top)
        ipc procs "${1:-toggle}"
        ;;
    clip|clipboard)
        ipc clipboard "${1:-list}"
        ;;
    power)
        case "${1:-menu}" in
            menu|lock|logout|suspend) ipc power "${1:-menu}" ;;
            *) ipc power menu ;;
        esac
        ;;
    media)
        ipc media "${1:-status}"
        ;;
    notify)
        case "${1:-status}" in
            toggle|dnd|clear|status|list) ipc notify "${1:-status}" ;;
            server) ipc notify server "${2:-toggle}" ;;
            *) ipc notify status ;;
        esac
        ;;
    tray)
        case "${1:-list}" in
            toggle) ipc tray toggle ;;
            *) ipc tray list ;;
        esac
        ;;
    osd)
        ipc osd "${1:-status}"
        ;;
    control)
        ipc control "${1:-toggle}"
        ;;
    brightness)
        case "${1:-}" in
            up|down) ipc brightness "$1" ;;
            *) ipc brightness set "${1:?Prozent fehlt}" ;;
        esac
        ;;
    wallpaper)
        case "${1:-current}" in
            on|off|toggle|current|pick|list) ipc wallpaper "${1:-current}" ;;
            *) ipc wallpaper set "$1" ;;
        esac
        ;;
    next|prev)
        ipc themes "$cmd"
        ;;
    get)
        ipc config get "${1:?Schluessel fehlt}"
        ;;
    set)
        ipc config set "${1:?Schluessel fehlt}" "${2:?Wert fehlt}"
        ;;
    config)
        ipc config dump
        ;;
    status)
        ipc bar status
        ;;
    *)
        exec "$QS" -c "$CONFIG_NAME" "$cmd" "$@"
        ;;
esac

#!/usr/bin/env bash
# nbshell -- Startet und steuert die Shell.
#
# Duenne Huelle um `qs -c nbshell`. Alles, was nicht als Unterbefehl bekannt
# ist, wandert unveraendert an Quickshell weiter.
set -euo pipefail

CONFIG_NAME="nbshell"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nbshell"
THEME_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/theme-install.sh"
PLUGIN_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/plugins.sh"

qs_bin() {
    if command -v qs >/dev/null 2>&1; then echo qs; else echo quickshell; fi
}

QS="$(qs_bin)"

ipc() {
    "$QS" -c "$CONFIG_NAME" ipc call "$@"
}

warn() { printf '\033[33m%s\033[0m\n' "$1"; }

# ── Umschalten zwischen DMS und nbshell ──────────────────────────────────
#
# Drei Dinge gehoeren zusammen, sonst ist der Zustand halb:
#   1. dms.service  -- die Unit ist Type=dbus auf org.freedesktop.Notifications
#                      und wird nie "active", wenn nbshell den Namen hat.
#   2. der Benachrichtigungsserver in nbshell.
#   3. die Tastenkuerzel, die bisher DMS gehoerten.
NIRI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
UNIT_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/niri.service.d/nbshell.conf"
GHOSTTY="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config"
ALACRITTY="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
TAKEOVER="nbshell-takeover.kdl"
COLORS="nbshell-colors.kdl"
INCLUDE_LINE="include \"$TAKEOVER\""
COLORS_LINE="include \"$COLORS\""

niri_include() {
    local cfg="$NIRI_DIR/config.kdl"
    [ -f "$cfg" ] || { echo "niri-Config nicht gefunden: $cfg" >&2; return 1; }
    grep -qF "$INCLUDE_LINE" "$cfg" && return 0
    cp "$cfg" "$cfg.vor-nbshell"
    # Die Farbdatei zuerst schreiben lassen -- ein include auf eine fehlende
    # Datei macht die ganze Config ungueltig.
    ipc theme write >/dev/null 2>&1 || true
    printf '\n// nbshell uebernimmt DMS-Tastenkuerzel und faerbt die Fensterrahmen\n// (nbshell switch off entfernt beides)\n%s\n' "$INCLUDE_LINE" >> "$cfg"
    [ -f "$NIRI_DIR/$COLORS" ] && printf '%s\n' "$COLORS_LINE" >> "$cfg"
    if ! niri validate >/dev/null 2>&1; then
        mv "$cfg.vor-nbshell" "$cfg"
        echo "niri-Config waere ungueltig geworden -- zurueckgenommen." >&2
        return 1
    fi
    echo "  niri:   $INCLUDE_LINE eingetragen (Sicherung: config.kdl.vor-nbshell)"
}

niri_exclude() {
    local cfg="$NIRI_DIR/config.kdl"
    grep -qF "$INCLUDE_LINE" "$cfg" || return 0
    cp "$cfg" "$cfg.vor-nbshell"
    grep -vF "$INCLUDE_LINE" "$cfg" | grep -vF "$COLORS_LINE" | grep -v "^// nbshell uebernimmt DMS-Tastenkuerzel" | grep -v "^// (nbshell switch off entfernt beides)" > "$cfg.neu"
    mv "$cfg.neu" "$cfg"
    niri validate >/dev/null 2>&1 || { mv "$cfg.vor-nbshell" "$cfg"; echo "zurueckgenommen." >&2; return 1; }
    echo "  niri:   $INCLUDE_LINE entfernt"
}

# ghostty liest genau EINE Themedatei. Solange DMS laeuft, schreibt matugen
# `dankcolors`; danach schreibt nbshell `nbcolors` bei jedem Themewechsel.
# Umgebogen wird nur die eine Zeile, mit Sicherung daneben.
ghostty_theme() {
    local want="$1"
    [ -f "$GHOSTTY" ] || return 0
    grep -q "^theme = $want\$" "$GHOSTTY" && return 0
    cp "$GHOSTTY" "$GHOSTTY.vor-nbshell"
    sed -i "s/^theme = .*/theme = $want/" "$GHOSTTY"
    echo "  ghostty: theme = $want (Sicherung: config.vor-nbshell)"
}

# Dasselbe fuer alacritty -- dort ist es kein `theme =`, sondern eine
# Importzeile. Geschrieben wird die Datei nicht von der Shell, sondern von
# theme-hook.sh; ohne den bleibt hier nichts zu tun, deshalb die Pruefung auf
# die Datei statt auf das Programm.
alacritty_theme() {
    local want="$1"
    [ -f "$ALACRITTY" ] || return 0
    grep -q "$want" "$ALACRITTY" && return 0
    grep -q "alacritty/\(nb\|dank\)-theme.toml" "$ALACRITTY" || return 0
    cp "$ALACRITTY" "$ALACRITTY.vor-nbshell"
    sed -i "s#alacritty/\(nb\|dank\)-theme.toml#alacritty/$want#" "$ALACRITTY"
    echo "  alacritty: import = $want (Sicherung: alacritty.toml.vor-nbshell)"
}

# ── Mauszeiger ───────────────────────────────────────────────────────────
#
# Gesetzt wird die CONFIG, nicht die niri-Datei: dort haengt seit dem
# Optionsmenue ein Dienst dran (Services/Cursor.qml), der beides nachzieht --
# niri und GTK. Wer hier direkt schriebe, haette zwei Wahrheiten, und die
# naechste Aenderung im Menue ueberschriebe sie wortlos.
CURSOR_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/cursors.sh"
MUSIC_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/ytm.py"
KEYS_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/keys.py"

cursor_status() {
    local jetzt
    jetzt="$(bash "$CURSOR_TOOL" current 2>/dev/null)"
    printf 'Thema     %s\n' "$(printf '%s' "$jetzt" | python3 -c 'import json,sys; print(json.load(sys.stdin)["theme"] or "(keins gesetzt)")' 2>/dev/null)"
    printf 'Groesse   %s px\n' "$(printf '%s' "$jetzt" | python3 -c 'import json,sys; print(json.load(sys.stdin)["size"])' 2>/dev/null)"
    if command -v gsettings >/dev/null 2>&1; then
        printf 'GTK       %s, %s px\n' "$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")" "$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null)"
    fi
    echo
    echo "Installiert:"
    bash "$CURSOR_TOOL" list | python3 -c 'import json,sys; [print("  "+t) for t in json.load(sys.stdin)]'
    echo
    echo "Weitere dazulegen: siehe README, \"Ein Theme dazuholen\""
    if [ -f "$NIRI_DIR/dms/cursor.kdl" ] && [ ! -s "$NIRI_DIR/dms/cursor.kdl" ]; then
        echo
        warn "niri bindet ausserdem dms/cursor.kdl ein -- die Datei ist LEER."
        warn "Ein Erbstueck von DMS. Es tut nichts; wer aufraeumen will, nimmt"
        warn "die include-Zeile aus der config.kdl."
    fi
}

cursor_set() {
    local thema="$1" groesse="${2:-}"
    bash "$CURSOR_TOOL" list | grep -q "\"$thema\"" || {
        echo "Unbekanntes Zeigerthema: $thema" >&2
        echo "Da waeren:" >&2
        bash "$CURSOR_TOOL" list | python3 -c 'import json,sys; [print("  "+t) for t in json.load(sys.stdin)]' >&2
        return 1
    }
    "$0" set cursorTheme "$thema" >/dev/null
    if [ -n "$groesse" ]; then
        case "$groesse" in
            ''|*[!0-9]*) echo "Groesse muss eine Zahl sein: $groesse" >&2; return 1 ;;
        esac
        "$0" set cursorSize "$groesse" >/dev/null
    fi
    echo "Zeiger: $thema${groesse:+, $groesse px}"
    echo "Gilt sofort fuer neue Fenster; laufende Programme behalten ihren."
}

# ── Schriftgroesse in einem Zug ──────────────────────────────────────────
#
# Die Idee stammt aus Omarchy 4 ("omarchy display text size"): EIN Regler, der
# Shell, GTK und Terminal zusammen bewegt. Vorher stellte man die Leiste um,
# fand die Menues zu klein, stellte GTK nach, und das Terminal blieb, wie es
# war.
#
# Drei Vorsichtsmassnahmen stecken darin:
#
#   1. Das Terminal wird NICHT auf die Pixelgroesse der Shell gesetzt. Es
#      rechnet in Punkt und stand hier auf 12, waehrend die Leiste auf 13 px
#      steht -- eine stumpfe Umrechnung haette es beim ersten Aufruf um ein
#      Viertel geschrumpft. Stattdessen wird das Verhaeltnis beim ersten Mal
#      gemessen und in der Config abgelegt (`terminalRatio`), danach bleibt es
#      erhalten.
#   2. GTKs Skalierung wird so gerundet, dass die GTK-Schrift auf einer GANZEN
#      Punktgroesse landet. Krumme Werte schneiden in GTK Menueeintraege ab --
#      derselbe Fehler, den Omarchy in dieser Runde behoben hat.
#   3. Geschrieben wird nur, was es schon gibt: keine ghostty-Config, kein
#      Eingriff; kein gsettings, kein GTK-Teil.
TEXT_MIN=8
TEXT_MAX=28

text_size() {
    local want="${1:-}"
    local shell_now
    shell_now="$("$0" get fontSize 2>/dev/null || true)"
    # KEIN `[ … ] || [ … ] && x`: schlagen beide Tests fehl, ist der Rueckgabewert
    # der Zeile 1 -- und unter `set -e` endet die Funktion genau hier, still.
    if [ -z "$shell_now" ] || [ "$shell_now" = "null" ]; then
        shell_now=13
    fi

    if [ -z "$want" ]; then
        printf 'Shell      %s px\n' "$shell_now"
        if [ -f "$GHOSTTY" ]; then
            printf 'ghostty    %s pt\n' "$(awk -F'= *' '/^font-size/ {print $2}' "$GHOSTTY")"
        fi
        if command -v gsettings >/dev/null 2>&1; then
            printf 'GTK        Faktor %s\n' "$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null)"
        fi
        echo
        echo "Aendern: nbshell text <$TEXT_MIN..$TEXT_MAX>"
        return 0
    fi

    case "$want" in
        ''|*[!0-9]*) echo "Zahl erwartet: nbshell text <$TEXT_MIN..$TEXT_MAX>" >&2; return 1 ;;
    esac
    if [ "$want" -lt "$TEXT_MIN" ] || [ "$want" -gt "$TEXT_MAX" ]; then
        echo "Ausserhalb von $TEXT_MIN..$TEXT_MAX: $want" >&2
        return 1
    fi

    # Terminal: Verhaeltnis einmal messen, dann behalten.
    local ratio term_now
    ratio="$("$0" get terminalRatio 2>/dev/null || true)"
    if [ -f "$GHOSTTY" ]; then
        term_now="$(awk -F'= *' '/^font-size/ {print $2}' "$GHOSTTY" | tr -d ' ')"
        if [ "$ratio" = "null" ] || [ -z "$ratio" ]; then
            ratio="$(python3 -c "print(round(float('${term_now:-12}') / float('${shell_now:-13}'), 4))")"
            "$0" set terminalRatio "$ratio" >/dev/null
        fi
    fi

    "$0" set fontSize "$want" >/dev/null
    echo "Shell      $want px"

    if [ -f "$GHOSTTY" ] && [ -n "${term_now:-}" ]; then
        local term_new
        term_new="$(python3 -c "print(max(6, round($want * float('$ratio'))))")"
        cp "$GHOSTTY" "$GHOSTTY.vor-nbshell"
        sed -i "s/^font-size *=.*/font-size = $term_new/" "$GHOSTTY"
        echo "ghostty    $term_new pt (Sicherung: config.vor-nbshell)"
        # ghostty liest von selbst nicht neu -- dasselbe Signal wie beim Theme.
        pkill -USR2 -x ghostty 2>/dev/null || true
    fi

    if command -v gsettings >/dev/null 2>&1; then
        local base factor
        base="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null | tr -d "'" | awk '{print $NF}')"
        factor="$(python3 -c "
base = float('${base:-11}')
want, ref = float('$want'), 13.0
# Auf eine ganze Punktgroesse einrasten, sonst schneidet GTK Menues ab.
print(round(max(1.0, round(base * want / ref) / base), 3))
")"
        if gsettings set org.gnome.desktop.interface text-scaling-factor "$factor" 2>/dev/null; then
            echo "GTK        Faktor $factor (${base:-11} pt -> $(python3 -c "print(round(float('${base:-11}')*float('$factor')))") pt)"
        fi
    fi
    return 0
}

# Damit nbshell nach dem Anmelden von selbst da ist. Dasselbe Muster, das DMS
# benutzt: ein Drop-in an niri.service, das die Unit mitzieht. Eine EIGENE
# Datei -- dms.conf bleibt unangetastet, damit der Rueckweg frei bleibt.
autostart_on() {
    mkdir -p "$(dirname "$UNIT_DROPIN")"
    printf '[Unit]\nWants=nbshell.service\n' > "$UNIT_DROPIN"
    systemctl --user daemon-reload 2>/dev/null
    systemctl --user enable nbshell.service >/dev/null 2>&1
    # Laeuft schon eine von Hand gestartete Instanz, uebernimmt sie die Unit
    # nicht -- also einmal sauber neu.
    "$QS" -c nbshell kill >/dev/null 2>&1 || true
    sleep 0.3
    systemctl --user restart nbshell.service 2>/dev/null && echo "  nbshell: startet ab jetzt beim Anmelden mit"
}

autostart_off() {
    rm -f "$UNIT_DROPIN"
    systemctl --user disable nbshell.service >/dev/null 2>&1
    systemctl --user daemon-reload 2>/dev/null
    echo "  nbshell: startet nicht mehr automatisch (laeuft weiter)"
}

# ── Rechteabfragen ───────────────────────────────────────────────────────
#
# polkitd fragt niemanden selbst. Es erwartet einen Agenten IN der Sitzung, der
# das Fenster mit der Passwortabfrage aufmacht -- ohne ihn scheitert `pkexec`
# still, und die Anwendung, die nach Rechten gefragt hat, meldet bestenfalls
# "nicht berechtigt". Unter einem Desktop bringt die Umgebung ihn mit; unter
# niri bringt ihn niemand mit, und man merkt es erst, wenn etwas nicht geht.
#
# nbshell hat keinen eigenen -- Quickshell hat keine Anbindung an polkit --,
# also wird ein vorhandener eingeschaltet. `hyprpolkitagent` ist die naechste
# Wahl: Qt/QML wie die Shell selbst, in `extra`, laeuft unter jedem
# wlroots-Kompositor und bringt seine eigene User-Unit mit.
POLKIT_UNITS="hyprpolkitagent.service polkit-gnome-authentication-agent-1.service lxqt-policykit-agent.service mate-polkit.service"

polkit_unit() {
    local unit
    for unit in $POLKIT_UNITS; do
        systemctl --user cat "$unit" >/dev/null 2>&1 && { echo "$unit"; return 0; }
    done
    return 1
}

polkit_running() {
    # Der Agent meldet sich als org.freedesktop.PolicyKit1.AuthenticationAgent
    # bei polkitd an -- am Bus sieht man ihn aber nur an seinem Prozess.
    pgrep -f 'polkit.*(agent|Agent)|polkit-gnome|lxqt-policykit|hyprpolkitagent' >/dev/null 2>&1
}

polkit_on() {
    local unit
    if unit="$(polkit_unit)"; then
        systemctl --user enable --now "$unit" >/dev/null 2>&1 \
            && echo "  polkit: $unit laeuft und startet mit" \
            || echo "  polkit: $unit liess sich nicht starten"
    else
        echo "  polkit: kein Agent installiert -- ohne ihn scheitert jede"
        echo "          Rechteabfrage still. sudo pacman -S hyprpolkitagent"
    fi
}

polkit_status() {
    local unit
    if unit="$(polkit_unit)"; then
        printf 'Agent            %s (%s)\n' "$unit" "$(systemctl --user is-active "$unit" 2>/dev/null)"
    elif polkit_running; then
        printf 'Agent            laeuft (ohne Unit, von Hand gestartet)\n'
    else
        printf 'Agent            keiner -- pacman -S hyprpolkitagent\n'
    fi
}

switch_on() {
    echo "nbshell uebernimmt:"
    if [ ! -f "$NIRI_DIR/$TAKEOVER" ]; then
        echo "  $TAKEOVER fehlt -- erst ./install.sh laufen lassen." >&2
        return 1
    fi
    systemctl --user stop dms.service 2>/dev/null && echo "  dms:    gestoppt"
    # `dms run` beendet sich mit 143 (SIGTERM). Die Unit hat dafuer kein
    # SuccessExitStatus, systemd merkt sie sich also als "failed" -- und sie
    # taucht auf ewig in `systemctl --user --failed` auf. Einmal quittieren.
    systemctl --user reset-failed dms.service 2>/dev/null || true
    # `disable` hilft hier NICHT: DMS haengt ueber ein Drop-in an niri.service
    # (~/.config/systemd/user/niri.service.d/dms.conf, "Wants=dms.service"),
    # kommt also bei jeder Anmeldung wieder. Nur `mask` haelt es dauerhaft weg
    # -- und das nur auf ausdrueckliche Ansage.
    if [ "${1:-}" = "dauerhaft" ]; then
        systemctl --user mask dms.service >/dev/null 2>&1 && echo "  dms:    maskiert, bleibt auch nach dem Anmelden weg"
    else
        echo "  dms:    kommt bei der naechsten Anmeldung wieder"
        echo "          (dauerhaft weg: nbshell switch on dauerhaft)"
    fi
    niri_include || true
    ipc notify server on >/dev/null && echo "  nbshell: Benachrichtigungsserver an"
    # Ohne DMS malt niemand mehr den Hintergrund -- sonst steht man vor einer
    # schwarzen Flaeche und sucht den Fehler bei sich.
    ipc wallpaper on >/dev/null && echo "  nbshell: Hintergrundbild an"
    ghostty_theme nbcolors
    alacritty_theme nb-theme.toml
    # Bleibt auch nach `switch off` an: der Agent gehoert nicht DMS, und DMS
    # bringt selbst keinen mit -- ihn wieder abzuschalten hiesse, das Loch
    # zurueckzugeben.
    polkit_on
    autostart_on
    echo
    echo "Mit DMS gehen auch dessen Plugins -- nbshell hat fuer jedes einen"
    echo "Ersatz: Insel, Arbeitsflaechen, Themewahl, Aufnahme, KI-Verbrauch."
    echo "Tot bleiben Mod+Comma, Mod+Y und Mod+Shift+N -- siehe $TAKEOVER."
}

switch_off() {
    echo "DMS uebernimmt wieder:"
    ipc notify server off >/dev/null && echo "  nbshell: Benachrichtigungsserver aus"
    ipc wallpaper off >/dev/null && echo "  nbshell: Hintergrundbild aus (DMS malt wieder)"
    ghostty_theme dankcolors
    alacritty_theme dank-theme.toml
    autostart_off
    niri_exclude || true
    systemctl --user unmask dms.service >/dev/null 2>&1
    systemctl --user start dms.service 2>/dev/null && echo "  dms:    gestartet"
}

switch_status() {
    printf 'dms.service      %s\n' "$(systemctl --user is-active dms.service 2>/dev/null; systemctl --user is-enabled dms.service 2>/dev/null | tr '\n' ' ')"
    printf 'Benachrichtigung %s\n' "$(busctl --user list 2>/dev/null | awk '/^org.freedesktop.Notifications/ {print $2" ("$3")"}')"
    printf 'niri-Binds       %s\n' "$(grep -qF "$INCLUDE_LINE" "$NIRI_DIR/config.kdl" && echo "nbshell" || echo "DMS")"
    printf 'Fensterrahmen    %s\n' "$(grep -qF "$COLORS_LINE" "$NIRI_DIR/config.kdl" && echo "nbshell" || echo "DMS")"
    printf 'nbshell-Autostart %s\n' "$([ -f "$UNIT_DROPIN" ] && echo "an ($(systemctl --user is-active nbshell.service))" || echo "aus")"
    polkit_status
}

usage() {
    cat <<'USAGE'
nbshell -- eigene Shell auf Quickshell

  nbshell start [-d]        startet die Shell (-d loest sie vom Terminal)
  nbshell stop              beendet sie
  nbshell restart

  nbshell bar               durchgehender Balken
  nbshell island            freistehende Insel, klappt zur Uhr zusammen
  nbshell pill              dieselbe Insel, bleibt aber offen
  nbshell mode toggle       reihum durch die drei Formen
  nbshell edge top|bottom|toggle
  nbshell open|close|toggle Insel festhalten (unabhaengig von der Maus)

  nbshell theme             zeigt das aktuelle Theme
  nbshell theme <name>      wechselt es
  nbshell themes            listet die vorhandenen
  nbshell theme install [--force] <url|verzeichnis>
                            Omarchy-Theme dazuholen (auch ohne colors.toml:
                            die Palette wird aus alacritty.toml abgeleitet).
                            Ist es schon da, passiert nichts -- --force
                            ersetzt es.
  nbshell theme remove <name>
  nbshell theme update      selbst installierte Themes aktualisieren
  nbshell picker            Themewahl aufklappen
  nbshell next | prev       ein Theme weiter/zurueck

  nbshell accent            welche Akzentrolle gilt (und die Auswahl)
  nbshell accent green      Akzent auf eine Farbe DES THEMES legen
  nbshell accent theme      zurueck zum Vorschlag des Themes

  nbshell widget                    wer ein eigenes Aussehen hat
  nbshell widget battery display icon
                            full | icon | text | auto
  nbshell widget clock style plain
                            box | bracket | plain | auto
  nbshell widget updates color red
                            eine Farbe des Themes, auto = wie alle
  nbshell widget updates reset
  nbshell widget reset all

  nbshell audio up|down     Lautstaerke (fuer die Multimediatasten)
  nbshell audio mute        stumm schalten
  nbshell audio <prozent>   fest einstellen
  nbshell audio status
  nbshell audio panel       Regler und Geraeteliste aufklappen

  nbshell launcher          Anwendungsstarter (Alias: run)
  nbshell find <text>       zeigt, was der Starter finden wuerde

  nbshell notify            Stand der Benachrichtigungen
  nbshell notify toggle     Archiv aufklappen
  nbshell notify dnd        "nicht stoeren" umschalten
  nbshell notify clear
  nbshell notify server on|off
                            uebernimmt org.freedesktop.Notifications von DMS
                            (dessen Unit muss dann gestoppt sein)

  nbshell modules           Bausteine der Leiste anordnen
  nbshell settings          Optionsmenue (Rand, Form, Optik, Schalter)
  nbshell updates           Updates: status, check, list, run
  nbshell ai                KI-Verbrauch (auch: refresh)
  nbshell capture           Aufnahme-Menue (screen, window, region, ocr, record)
  nbshell procs             Prozessliste (auch: top)
  nbshell menu              Menue (verschachtelt) — Mod+Shift+Space
  nbshell clip              Verlauf der Zwischenablage (toggle, list, clear)
  nbshell cal               Kalender (auch: next, sync, status)

  nbshell todo              Aufgaben auflisten
  nbshell todo <text>       eintragen (auch: todo add <text>)
  nbshell todo toggle       die Liste als Fenster (Mod+T)
  nbshell todo done <nr>    abhaken -- die Nummer aus `nbshell todo`
  nbshell todo drop <nr>    wegwerfen
  nbshell todo clear        alle erledigten aufraeumen
  nbshell todo sync         Konfliktkopien einsammeln und neu lesen
  nbshell todo status       Zahlen und Ablageort

  nbshell habits            Gewohnheiten (nbHabits) auflisten (auch: habits list)
  nbshell habits toggle <nr> abhaken / toggle
  nbshell habits done <nr>  als erledigt markieren
  nbshell habits inc <nr> [x] Zaehler erhoehen (z.B. habits inc 1 1)
  nbshell habits <text>     neue Gewohnheit eintragen (z.B. habits joggen // workout)
  nbshell habits open       Vollbildfenster mit 20-Wochen-Heatmap oeffnen
  nbshell habits sync       Konfliktkopien einsammeln und neu lesen
  nbshell habits status     Zahlen, Quote und Ablageort

  nbshell plugins           Bausteine auflisten (auch: reload)
  nbshell plugin add <url>  fremdes Bar-Widget aus git holen (laeuft IN der
                            Shell -- nur, wem du traust)
  nbshell plugin update [name]
  nbshell plugin remove <name>
  nbshell popout <name>     Popout eines Bausteins aufklappen
  nbshell battery           Akku und Energieprofil (bat <profil> wechselt)
  nbshell power             Power-Menue (auch: lock, logout, suspend)
  nbshell media playpause|next|previous|status

  nbshell tray              zeigt, was im Tray steckt
  nbshell tray toggle       Symbole ein- und ausklappen
  nbshell osd test|on|off   Einblendung beim Regeln
  nbshell control           Control Center (Helligkeit, WLAN, Bluetooth)
  nbshell brightness up|down|<prozent>

  nbshell wallpaper on|off  Hintergrundbild des Themes (aus, solange DMS laeuft)
  nbshell wallpaper pick    Karussell: Bilder des Themes durchblaettern
  nbshell wallpaper list
  nbshell wallpaper <pfad>  festes Bild statt des Themebildes

  nbshell get <key>         Wert aus der Config
  nbshell set <key> <wert>  Wert setzen (JSON erlaubt: 12, true, ["a","b"])
  nbshell config            zeigt die ganze Config
  nbshell state             was gerade offen ist
  nbshell status

  nbshell switch on [dauerhaft]
                            DMS weicht: Unit aus, Benachrichtigungen und
                            Tastenkuerzel zu nbshell
  nbshell switch off        alles zurueck zu DMS
  nbshell switch status

  nbshell launcher          Starter: Anwendungen UND Befehle
  nbshell palette           derselbe Starter, nur die Befehle
  nbshell find <text>       was der Starter zu <text> anbietet
  nbshell befehle [text]    alle Befehle der Palette (Mod+Space, ">")
  nbshell befehl <text>     den besten Treffer ausfuehren

  nbshell nearby scan       Geraete in der Naehe suchen (LocalSend)
  nbshell nearby            gefundene Geraete auflisten
  nbshell nearby send <datei> [alias]

  nbshell music login       YouTube Music verbinden (Cookies einfuegen)
  nbshell music status      angemeldet? wie viele Playlists?
  nbshell music playlists   eigene Playlists auflisten
  nbshell music suche <text>  Titel suchen

  nbshell keys              alle Tastenkuerzel (Fenster, Mod+K)
  nbshell keys liste        dieselben Kuerzel im Terminal

  nbshell ton               Ton zurueck auf die Bluetooth-Hoerer
  nbshell codec             welcher Bluetooth-Codec laeuft
  nbshell codec beste       auf den besten verfuegbaren wechseln
  nbshell qr                WLAN als QR-Code (Fenster, Esc schliesst)
  nbshell speed             Durchsatz messen (Fenster, Leertaste wiederholt)

  nbshell wach              Rechner wachhalten (aus/an, ohne Argument: um)
  nbshell idle              Stand der Leerlauf-Automatik
  nbshell idle on|off       Automatik ein- oder ausschalten
  nbshell saver             Bildschirmschoner jetzt starten

  nbshell cursor            Zeigerthema und -groesse, und was installiert ist
  nbshell cursor Adwaita 28 beides setzen (Groesse ist freiwillig)

  nbshell text              welche Schriftgroessen gerade gelten
  nbshell text <8..28>      Shell, GTK und Terminal zusammen umstellen

  nbshell polkit            laeuft ein Agent fuer Rechteabfragen?
  nbshell polkit on         einen vorhandenen einschalten

Alles andere geht unveraendert an Quickshell:
  nbshell log, nbshell ipc show, ...
USAGE
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    ""|-h|--help|help)
        usage
        ;;
    start)
        exec "$QS" -c "$CONFIG_NAME" "$@"
        ;;
    stop)
        exec "$QS" -c "$CONFIG_NAME" kill
        ;;
    restart)
        # Duplikatsicher: laeuft nbshell als systemd-Dienst, uebernimmt der die
        # Einzel-Instanz-Garantie. Frueher liess `qs kill` detachte Instanzen
        # ueberleben und `-d` startete eine ZWEITE neben dem Dienst -> mehrere
        # Bars. Deshalb erst dem Dienst den Vortritt geben.
        if systemctl --user is-enabled nbshell.service >/dev/null 2>&1 \
           || systemctl --user is-active nbshell.service >/dev/null 2>&1; then
            exec systemctl --user restart nbshell.service
        fi
        # Fallback ohne Dienst: ALLE nbshell-qs-Instanzen sicher beenden.
        "$QS" -c "$CONFIG_NAME" kill 2>/dev/null || true
        for pid in $(pgrep -x qs 2>/dev/null); do
            grep -qz -- "$CONFIG_NAME" "/proc/$pid/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null
        done
        sleep 0.4
        exec "$QS" -c "$CONFIG_NAME" -d
        ;;
    bar|island|pill)
        ipc bar mode "$cmd" >/dev/null && echo "$cmd"
        ;;
    mode|edge)
        ipc bar "$cmd" "${1:-toggle}"
        ;;
    open|close|toggle)
        ipc bar "$cmd"
        ;;
    theme)
        case "${1:-}" in
            # `current` MUSS hier stehen: sonst landet es im Zweig darunter
            # und setzt das Theme auf den Namen "current".
            ""|current) ipc theme current ;;
            install|remove|update|list)
                # Nach dem Installieren die Liste neu einlesen, sonst taucht
                # das Theme erst nach einem Neustart in der Auswahl auf.
                "$THEME_TOOL" "$@" && ipc themes reload >/dev/null 2>&1
                ;;
            write) ipc theme write ;;
            *) ipc theme set "$1" ;;
        esac
        ;;
    themes)
        # Aus der laufenden Shell, damit der Stern stimmt; ohne sie vom Datei-
        # system.
        if ! ipc themes list 2>/dev/null; then
            for d in "$CONFIG_DIR"/themes/*/; do printf '   %s\n' "$(basename "$d")"; done
        fi
        ;;
    picker)
        ipc themes toggle
        ;;
    accent|akzent)
        ipc theme accent "${1:-status}"
        ;;
    widget|baustein)
        case "${1:-list}" in
            ""|list)  ipc widget list ;;
            reset)    shift; ipc widget reset "${1:-all}" ;;
            *)        ipc widget set "${1:?Baustein fehlt}" "${2:?Merkmal fehlt (display|style|color)}" "${3:?Wert fehlt}" ;;
        esac
        ;;
    audio)
        case "${1:-status}" in
            up|down|mute|micmute|status|panel) ipc audio "${1:-status}" ;;
            *) ipc audio set "$1" ;;
        esac
        ;;
    launcher|run)
        ipc launcher "${1:-toggle}"
        ;;
    palette)
        ipc launcher palette
        ;;
    find)
        ipc launcher find "${1:?Suchbegriff fehlt}"
        ;;
    befehle|commands)
        ipc launcher commands "${1:-}"
        ;;
    befehl)
        ipc launcher exec "${1:?Name fehlt}"
        ;;
    switch)
        case "${1:-status}" in
            on) shift; switch_on "$@" ;;
            off) switch_off ;;
            *) switch_status ;;
        esac
        ;;
    cursor|zeiger)
        if [ $# -eq 0 ]; then
            cursor_status
        else
            cursor_set "$@"
        fi
        ;;
    text)
        text_size "${1:-}"
        ;;
    nearby|naehe)
        case "${1:-list}" in
            scan)   ipc nearby scan ;;
            list|"") ipc nearby list ;;
            send)   shift
                    datei="$(realpath -e "${1:?Datei fehlt}")" || exit 1
                    if [ -n "${2:-}" ]; then ipc nearby sendTo "$datei" "$2"; else ipc nearby send "$datei"; fi ;;
            *)      ipc nearby status ;;
        esac
        ;;
    codec)
        # Ohne Argument die Auskunft, mit Argument umschalten:
        #   nbshell codec           -> AAC  (es ginge …)
        #   nbshell codec beste     -> den hoechstplatzierten nehmen
        #   nbshell codec sbc-xq    -> einen bestimmten
        ipc audio codec "${1:-}"
        ;;
    keys|tasten)
        case "${1:-fenster}" in
            # Die Liste kommt DIREKT aus dem Skript, nicht ueber die Shell:
            # sie liest niris Konfiguration, nicht den Zustand der Shell -- und
            # soll deshalb auch antworten, wenn nbshell gar nicht laeuft.
            liste|list)
                python3 "$KEYS_TOOL" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("ok"):
    sys.exit(d.get("grund", "unbekannt"))
# Nach Gruppen sortiert wie im Fenster, nicht in der Reihenfolge der
# Konfiguration -- sonst steht dieselbe Ueberschrift viermal da.
ordnung = ["Programme", "Fenster", "Arbeitsflaechen", "Bildschirme",
           "Ton und Licht", "Aufnahme", "Sitzung", "Sonstiges"]
d["binds"].sort(key=lambda b: ordnung.index(b["gruppe"]) if b["gruppe"] in ordnung else len(ordnung))
gruppe = None
for b in d["binds"]:
    if b["gruppe"] != gruppe:
        gruppe = b["gruppe"]
        print()
        print(gruppe.upper())
    print("  %-26s %s" % (b["taste"], b["text"]))
' ;;
            neu|reload)      ipc keys reload ;;
            *)               ipc keys toggle ;;
        esac
        ;;
    music|musik)
        # Direkt ans Skript, nicht ueber die Shell: Anmelden und Nachsehen muss
        # auch gehen, wenn nbshell gar nicht laeuft -- und beim Anmelden wandert
        # ein mehrzeiliger Einfuegetext durch stdin, den IPC nicht durchreicht.
        unter="${1:-status}"; shift || true
        case "$unter" in
            login|anmelden)
                cat >&2 <<'ENDE'
YouTube Music verbinden — einmal einrichten:

  1. music.youtube.com im Browser oeffnen, angemeldet sein
  2. F12 -> Reiter "Netzwerk"
  3. eine beliebige Anfrage an music.youtube.com anklicken
  4. Rechtsklick -> Copy -> Copy request headers
  5. hier einfuegen, dann Strg-D (in einer neuen Zeile)

Die Cookies landen in ~/.config/nbshell/ytmusic.json (Rechte 600) und sind
ein Passwort-Aequivalent. Sie sind vom Dotfiles-Repo ausgeschlossen.

Jetzt einfuegen:
ENDE
                python3 "$MUSIC_TOOL" login ;;
            fenster|window) ipc music toggle ;;
            play|spiel)     ipc music play "${1:?Titel-ID fehlt}" "${2:-}" ;;
            stop)           ipc music stop ;;
            queue|liste)    ipc music queue ;;
            suche|search)   python3 "$MUSIC_TOOL" search "$@" ;;
            *)              python3 "$MUSIC_TOOL" "$unter" "$@" ;;
        esac
        ;;
    ton|audio)
        ipc audio zurueck
        ;;
    qr)
        ipc net qr
        ;;
    speed|speedtest)
        ipc net speed
        ;;
    wach|caffeine|koffein)
        ipc idle caffeine "${1:-toggle}"
        ;;
    idle|leerlauf)
        case "${1:-status}" in
            on|an)   ipc idle on ;;
            off|aus) ipc idle off ;;
            *)       ipc idle status ;;
        esac
        ;;
    saver|schoner)
        ipc idle saver
        ;;
    polkit)
        case "${1:-status}" in
            on) polkit_on ;;
            *) polkit_status ;;
        esac
        ;;
    state)
        ipc state dump
        ;;
    settings)
        ipc settings toggle
        ;;
    modules)
        ipc settings modules
        ;;
    updates)
        ipc updates "${1:-status}"
        ;;
    ai)
        ipc ai "${1:-status}"
        ;;
    capture)
        ipc capture "${1:-menu}"
        ;;
    procs|top)
        ipc procs "${1:-toggle}"
        ;;
    menu)
        ipc menu "${1:-toggle}"
        ;;
    cal|calendar)
        ipc calendar "${1:-toggle}"
        ;;
    plugins|plugin)
        # `list` fragt die laufende Shell (die kennt auch die eingebauten
        # Bausteine); alles andere greift auf die Verzeichnisse zu und geht
        # deshalb direkt an das Skript -- es muss auch dann gehen, wenn die
        # Shell gerade nicht laeuft.
        case "${1:-list}" in
            add|remove|rm|update)
                "$PLUGIN_TOOL" "$@"
                ;;
            *)
                ipc plugins "${1:-list}"
                ;;
        esac
        ;;
    popout)
        ipc popout toggle "${1:?Name fehlt}"
        ;;
    clip|clipboard)
        ipc clipboard "${1:-list}"
        ;;
    todo|aufgaben)
        case "${1:-list}" in
            toggle|open) ipc todo toggle ;;
            list|"")     ipc todo list ;;
            sync)        ipc todo sync ;;
            clear)       ipc todo clear ;;
            status)      ipc todo status ;;
            done)        ipc todo done "${2:?Nummer fehlt}" ;;
            drop|rm)     ipc todo drop "${2:?Nummer fehlt}" ;;
            add)
                shift
                [ $# -gt 0 ] || { echo "Text fehlt" >&2; exit 2; }
                # Alle Wörter als EIN Eintrag: `nbshell todo add Milch kaufen`
                # soll nicht zwei Aufgaben anlegen.
                text="$*"
                # Dieselbe Kodierung wie bei `set`: Quickshells IPC-Aufrufer
                # zerlegt Kommas, Semikola und eckige Klammern zu Argumenten.
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc todo add "$text"
                ;;
            *)
                # Ohne Unterbefehl ist alles Weitere der Text -- der kuerzeste
                # Weg zum Eintragen: `nbshell todo Milch kaufen`
                text="$*"
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc todo add "$text"
                ;;
        esac
        ;;
    habits|gewohnheiten)
        case "${1:-list}" in
            toggle|open) ipc habits toggle ;;
            list|"")     ipc habits list ;;
            sync)        ipc habits sync ;;
            status)      ipc habits status ;;
            done)        ipc habits done "${2:?Nummer fehlt}" ;;
            inc)         ipc habits inc "${2:?Nummer fehlt}" "${3:-1}" ;;
            drop|rm)     ipc habits drop "${2:?Nummer fehlt}" ;;
            add)
                shift
                [ $# -gt 0 ] || { echo "Text fehlt (z.B. joggen // workout)" >&2; exit 2; }
                text="$*"
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc habits add "$text"
                ;;
            *)
                text="$*"
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc habits add "$text"
                ;;
        esac
        ;;
    battery|bat)
        case "${1:-status}" in
            status|"") ipc battery status ;;
            *) ipc battery profile "$1" ;;
        esac
        ;;
    power)
        case "${1:-menu}" in
            menu|lock|logout|suspend) ipc power "${1:-menu}" ;;
            *) ipc power menu ;;
        esac
        ;;
    media)
        ipc media "${1:-status}"
        ;;
    notify)
        case "${1:-status}" in
            toggle|dnd|clear|status|list) ipc notify "${1:-status}" ;;
            server) ipc notify server "${2:-toggle}" ;;
            *) ipc notify status ;;
        esac
        ;;
    tray)
        case "${1:-list}" in
            toggle) ipc tray toggle ;;
            *) ipc tray list ;;
        esac
        ;;
    osd)
        ipc osd "${1:-status}"
        ;;
    control)
        ipc control "${1:-toggle}"
        ;;
    brightness)
        case "${1:-}" in
            up|down) ipc brightness "$1" ;;
            *) ipc brightness set "${1:?Prozent fehlt}" ;;
        esac
        ;;
    wallpaper)
        case "${1:-current}" in
            on|off|toggle|current|pick|list) ipc wallpaper "${1:-current}" ;;
            *) ipc wallpaper set "$1" ;;
        esac
        ;;
    next|prev)
        ipc themes "$cmd"
        ;;
    get)
        ipc config get "${1:?Schluessel fehlt}"
        ;;
    set)
        # Quickshells IPC-Aufrufer liest eckige Klammern als ARGUMENTLISTE und
        # zerlegt ausserdem an Kommas und Semikola: aus '["a","b"]' werden drei
        # Argumente, und der Aufruf scheitert mit "2 required but 3 were
        # provided". Steuerzeichen helfen nicht -- 0x1F ist sein eigenes
        # Trennzeichen. Also gehen die vier Zeichen prozentkodiert ueber die
        # Leitung; shell.qml dreht das zurueck.
        key="${1:?Schluessel fehlt}"
        value="${2:?Wert fehlt}"
        value="${value//%/%25}"
        value="${value//,/%2C}"
        value="${value//;/%3B}"
        value="${value//[/%5B}"
        value="${value//]/%5D}"
        ipc config set "$key" "$value"
        ;;
    config)
        ipc config dump
        ;;
    status)
        ipc bar status
        ;;
    *)
        exec "$QS" -c "$CONFIG_NAME" "$cmd" "$@"
        ;;
esac

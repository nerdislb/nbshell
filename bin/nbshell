#!/usr/bin/env bash
# nbshell -- Startet und steuert die Shell.
#
# Duenne Huelle um `qs -c nbshell`. Alles, was nicht als Unterbefehl bekannt
# ist, wandert unveraendert an Quickshell weiter.
set -euo pipefail

CONFIG_NAME="nbshell"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/nbshell"
RUNTIME_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell"
VERSION_FILE="$RUNTIME_DIR/VERSION"
THEME_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/theme-install.sh"
PLUGIN_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/plugins.sh"
DISPLAY_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/displays.py"

qs_bin() {
    if command -v qs >/dev/null 2>&1; then echo qs; else echo quickshell; fi
}

QS="$(qs_bin)"

ipc() {
    "$QS" -c "$CONFIG_NAME" ipc call "$@"
}

warn() { printf '\033[33m%s\033[0m\n' "$1"; }
die() { printf '\033[31m%s\033[0m\n' "$1" >&2; exit 1; }

# ── Eigenstaendig ein- und ausschalten ───────────────────────────────────
NIRI_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/niri"
UNIT_DROPIN="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/niri.service.d/nbshell.conf"
GHOSTTY="${XDG_CONFIG_HOME:-$HOME/.config}/ghostty/config"
ALACRITTY="${XDG_CONFIG_HOME:-$HOME/.config}/alacritty/alacritty.toml"
TAKEOVER="nbshell-takeover.kdl"
COLORS="nbshell-colors.kdl"
INCLUDE_LINE="include \"$TAKEOVER\""
COLORS_LINE="include \"$COLORS\""

compositor_name() {
    if [ -n "${NBSHELL_COMPOSITOR:-}" ]; then
        printf '%s\n' "${NBSHELL_COMPOSITOR,,}"
    elif [ -n "${UMBRIEL_SOCKET:-}" ] || [[ "${XDG_CURRENT_DESKTOP:-}" == *[Uu]mbriel* ]]; then
        echo umbriel
    else
        echo niri
    fi
}

niri_include() {
    local cfg="$NIRI_DIR/config.kdl"
    mkdir -p "$NIRI_DIR"
    if [ ! -f "$cfg" ]; then
        printf '// Standalone niri configuration created by nbshell\n' > "$cfg"
    fi
    grep -qF "$INCLUDE_LINE" "$cfg" && return 0
    cp "$cfg" "$cfg.vor-nbshell"
    # Die Farbdatei zuerst schreiben lassen -- ein include auf eine fehlende
    # Datei macht die ganze Config ungueltig.
    ipc theme write >/dev/null 2>&1 || true
    printf '\n// nbshell key bindings and window borders\n%s\n' "$INCLUDE_LINE" >> "$cfg"
    [ -f "$NIRI_DIR/$COLORS" ] && printf '%s\n' "$COLORS_LINE" >> "$cfg"
    if ! niri validate >/dev/null 2>&1; then
        mv "$cfg.vor-nbshell" "$cfg"
        echo "niri configuration became invalid -- reverted." >&2
        return 1
    fi
    echo "  niri:   $INCLUDE_LINE added (backup: config.kdl.vor-nbshell)"
}

niri_exclude() {
    local cfg="$NIRI_DIR/config.kdl"
    grep -qF "$INCLUDE_LINE" "$cfg" || return 0
    cp "$cfg" "$cfg.vor-nbshell"
    grep -vF "$INCLUDE_LINE" "$cfg" | grep -vF "$COLORS_LINE" | grep -v "^// nbshell key bindings and window borders" | grep -v "^// nbshell uebernimmt DMS-Tastenkuerzel" | grep -v "^// (nbshell switch off removed beides)" > "$cfg.neu"
    mv "$cfg.neu" "$cfg"
    niri validate >/dev/null 2>&1 || { mv "$cfg.vor-nbshell" "$cfg"; echo "reverted." >&2; return 1; }
    echo "  niri:   $INCLUDE_LINE removed"
}

# ghostty liest genau EINE Themedatei. Solange DMS laeuft, schreibt matugen
# `dankcolors`; danach schreibt nbshell `nbcolors` bei jedem Themewechsel.
# Umgebogen wird nur die eine Zeile, mit Sicherung daneben.
ghostty_theme() {
    local want="$1"
    [ -f "$GHOSTTY" ] || return 0
    grep -q "^theme = $want\$" "$GHOSTTY" && return 0
    cp "$GHOSTTY" "$GHOSTTY.vor-nbshell"
    sed -i "s/^theme = .*/theme = $want/" "$GHOSTTY"
    echo "  ghostty: theme = $want (backup: config.vor-nbshell)"
}

# Dasselbe fuer alacritty -- dort ist es kein `theme =`, sondern eine
# Importzeile. Geschrieben wird die Datei nicht von der Shell, sondern von
# theme-hook.sh; ohne den bleibt hier nichts zu tun, deshalb die Pruefung auf
# die Datei statt auf das Programm.
alacritty_theme() {
    local want="$1"
    [ -f "$ALACRITTY" ] || return 0
    grep -q "$want" "$ALACRITTY" && return 0
    grep -q "alacritty/\(nb\|dank\)-theme.toml" "$ALACRITTY" || return 0
    cp "$ALACRITTY" "$ALACRITTY.vor-nbshell"
    sed -i "s#alacritty/\(nb\|dank\)-theme.toml#alacritty/$want#" "$ALACRITTY"
    echo "  alacritty: import = $want (backup: alacritty.toml.vor-nbshell)"
}

# ── Mauszeiger ───────────────────────────────────────────────────────────
#
# Gesetzt wird die CONFIG, nicht die niri-Datei: dort haengt seit dem
# Optionsmenue ein Dienst dran (Services/Cursor.qml), der beides nachzieht --
# niri und GTK. Wer hier direkt schriebe, haette zwei Wahrheiten, und die
# naechste Aenderung im Menue ueberschriebe sie wortlos.
CURSOR_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/cursors.sh"
KEYS_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/keys.py"
PIP_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/zen-pip.py"
AGENT_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/agents.py"
GAMING_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/gaming.sh"
GRID_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/grid-layout.py"
BROWSER_THEME_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/browser-theme.sh"
OMACUT_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/omacut.sh"
SHELL_UPDATE_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/nbshell-update.py"
SYSTEM_REPORT_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/system-report.py"
MEMORY_GUARD_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/memory-guard.sh"
DEMO_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/demo.sh"
UMBRIEL_UPDATE_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/umbriel-update.py"
OMAWHATSAPP_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/omawhatsapp.sh"
AETHER_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/aether.sh"
UMBRIEL_NESTED_TOOL="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell/nbshell/scripts/umbriel-nested.sh"
GREETER_SETUP="${XDG_DATA_HOME:-$HOME/.local/share}/nbshell/setup-greeter.sh"

cursor_status() {
    local jetzt
    jetzt="$(bash "$CURSOR_TOOL" current 2>/dev/null)"
    printf 'Theme     %s\n' "$(printf '%s' "$jetzt" | python3 -c 'import json,sys; print(json.load(sys.stdin)["theme"] or "(not set)")' 2>/dev/null)"
    printf 'Size      %s px\n' "$(printf '%s' "$jetzt" | python3 -c 'import json,sys; print(json.load(sys.stdin)["size"])' 2>/dev/null)"
    if command -v gsettings >/dev/null 2>&1; then
        printf 'GTK       %s, %s px\n' "$(gsettings get org.gnome.desktop.interface cursor-theme 2>/dev/null | tr -d "'")" "$(gsettings get org.gnome.desktop.interface cursor-size 2>/dev/null)"
    fi
    echo
    echo "Installed:"
    bash "$CURSOR_TOOL" list | python3 -c 'import json,sys; [print("  "+t) for t in json.load(sys.stdin)]'
    echo
    echo "Install more cursor themes through your package manager."
    if [ -f "$NIRI_DIR/dms/cursor.kdl" ] && [ ! -s "$NIRI_DIR/dms/cursor.kdl" ]; then
        echo
        warn "niri also includes dms/cursor.kdl, but the file is EMPTY."
        warn "This is a harmless DMS remnant. To clean it up, remove"
        warn "its include line from config.kdl."
    fi
}

cursor_set() {
    local thema="$1" groesse="${2:-}"
    bash "$CURSOR_TOOL" list | grep -q "\"$thema\"" || {
        echo "Unknown cursor theme: $thema" >&2
        echo "Available themes:" >&2
        bash "$CURSOR_TOOL" list | python3 -c 'import json,sys; [print("  "+t) for t in json.load(sys.stdin)]' >&2
        return 1
    }
    "$0" set cursorTheme "$thema" >/dev/null
    if [ -n "$groesse" ]; then
        case "$groesse" in
            ''|*[!0-9]*) echo "Size must be a number: $groesse" >&2; return 1 ;;
        esac
        "$0" set cursorSize "$groesse" >/dev/null
    fi
    echo "Cursor: $thema${groesse:+, $groesse px}"
    echo "Applies to new windows immediately; running applications keep their current cursor."
}

# ── Schriftgroesse in einem Zug ──────────────────────────────────────────
#
# Die Idee stammt aus Omarchy 4 ("omarchy display text size"): EIN Regler, der
# Shell, GTK und Terminal zusammen bewegt. Vorher stellte man die Leiste um,
# fand die Menues zu klein, stellte GTK nach, und das Terminal blieb, wie es
# war.
#
# Drei Vorsichtsmassnahmen stecken darin:
#
#   1. Das Terminal wird NICHT auf die Pixelgroesse der Shell gesetzt. Es
#      rechnet in Punkt und stand hier auf 12, waehrend die Leiste auf 13 px
#      steht -- eine stumpfe Umrechnung haette es beim ersten Aufruf um ein
#      Viertel geschrumpft. Stattdessen wird das Verhaeltnis beim ersten Mal
#      gemessen und in der Config abgelegt (`terminalRatio`), danach bleibt es
#      erhalten.
#   2. GTKs Skalierung wird so gerundet, dass die GTK-Schrift auf einer GANZEN
#      Punktgroesse landet. Krumme Werte schneiden in GTK Menueeintraege ab --
#      derselbe Fehler, den Omarchy in dieser Runde behoben hat.
#   3. Geschrieben wird nur, was es schon gibt: keine ghostty-Config, kein
#      Eingriff; kein gsettings, kein GTK-Teil.
TEXT_MIN=8
TEXT_MAX=28

text_size() {
    local want="${1:-}"
    local shell_now
    shell_now="$("$0" get fontSize 2>/dev/null || true)"
    # KEIN `[ … ] || [ … ] && x`: schlagen beide Tests fehl, ist der Rueckgabewert
    # der Zeile 1 -- und unter `set -e` endet die Funktion genau hier, still.
    if [ -z "$shell_now" ] || [ "$shell_now" = "null" ]; then
        shell_now=13
    fi

    if [ -z "$want" ]; then
        printf 'Shell      %s px\n' "$shell_now"
        if [ -f "$GHOSTTY" ]; then
            printf 'ghostty    %s pt\n' "$(awk -F'= *' '/^font-size/ {print $2}' "$GHOSTTY")"
        fi
        if command -v gsettings >/dev/null 2>&1; then
            printf 'GTK        scale %s\n' "$(gsettings get org.gnome.desktop.interface text-scaling-factor 2>/dev/null)"
        fi
        echo
        echo "Change: nbshell text <$TEXT_MIN..$TEXT_MAX>"
        return 0
    fi

    case "$want" in
        ''|*[!0-9]*) echo "Expected a number: nbshell text <$TEXT_MIN..$TEXT_MAX>" >&2; return 1 ;;
    esac
    if [ "$want" -lt "$TEXT_MIN" ] || [ "$want" -gt "$TEXT_MAX" ]; then
        echo "Outside the supported range $TEXT_MIN..$TEXT_MAX: $want" >&2
        return 1
    fi

    # Terminal: Verhaeltnis einmal messen, dann behalten.
    local ratio term_now
    ratio="$("$0" get terminalRatio 2>/dev/null || true)"
    if [ -f "$GHOSTTY" ]; then
        term_now="$(awk -F'= *' '/^font-size/ {print $2}' "$GHOSTTY" | tr -d ' ')"
        if [ "$ratio" = "null" ] || [ -z "$ratio" ]; then
            ratio="$(python3 -c "print(round(float('${term_now:-12}') / float('${shell_now:-13}'), 4))")"
            "$0" set terminalRatio "$ratio" >/dev/null
        fi
    fi

    "$0" set fontSize "$want" >/dev/null
    echo "Shell      $want px"

    if [ -f "$GHOSTTY" ] && [ -n "${term_now:-}" ]; then
        local term_new
        term_new="$(python3 -c "print(max(6, round($want * float('$ratio'))))")"
        cp "$GHOSTTY" "$GHOSTTY.vor-nbshell"
        sed -i "s/^font-size *=.*/font-size = $term_new/" "$GHOSTTY"
        echo "ghostty    $term_new pt (backup: config.vor-nbshell)"
        # ghostty liest von selbst nicht neu -- dasselbe Signal wie beim Theme.
        pkill -USR2 -x ghostty 2>/dev/null || true
    fi

    if command -v gsettings >/dev/null 2>&1; then
        local base factor
        base="$(gsettings get org.gnome.desktop.interface font-name 2>/dev/null | tr -d "'" | awk '{print $NF}')"
        factor="$(python3 -c "
base = float('${base:-11}')
want, ref = float('$want'), 13.0
# Auf eine ganze Punktgroesse einrasten, sonst schneidet GTK Menues ab.
print(round(max(1.0, round(base * want / ref) / base), 3))
")"
        if gsettings set org.gnome.desktop.interface text-scaling-factor "$factor" 2>/dev/null; then
            echo "GTK        scale $factor (${base:-11} pt -> $(python3 -c "print(round(float('${base:-11}')*float('$factor')))") pt)"
        fi
    fi
    return 0
}

# Damit nbshell nach dem Anmelden von selbst da ist. Dasselbe Muster, das DMS
# benutzt: ein Drop-in an niri.service, das die Unit mitzieht. Eine EIGENE
# Datei -- dms.conf bleibt unangetastet, damit der Rueckweg frei bleibt.
autostart_on() {
    if [ "$(compositor_name)" = "niri" ]; then
        mkdir -p "$(dirname "$UNIT_DROPIN")"
        printf '[Unit]\nWants=nbshell.service\n' > "$UNIT_DROPIN"
    fi
    systemctl --user daemon-reload 2>/dev/null
    systemctl --user enable nbshell.service >/dev/null 2>&1
    # Laeuft schon eine von Hand gestartete Instanz, uebernimmt sie die Unit
    # nicht -- also einmal sauber neu.
    "$QS" -c nbshell kill >/dev/null 2>&1 || true
    sleep 0.3
    systemctl --user restart nbshell.service 2>/dev/null && echo "  nbshell: now starts at login"
}

autostart_off() {
    rm -f "$UNIT_DROPIN"
    systemctl --user disable nbshell.service >/dev/null 2>&1
    systemctl --user daemon-reload 2>/dev/null
    echo "  nbshell: will no longer start automatically (still running now)"
}

# ── Rechteabfragen ───────────────────────────────────────────────────────
#
# polkitd fragt niemanden selbst. Es erwartet einen Agenten IN der Sitzung, der
# das Fenster mit der Passwortabfrage aufmacht -- ohne ihn scheitert `pkexec`
# still, und die Anwendung, die nach Rechten gefragt hat, meldet bestenfalls
# "nicht berechtigt". Unter einem Desktop bringt die Umgebung ihn mit; unter
# niri bringt ihn niemand mit, und man merkt es erst, wenn etwas nicht geht.
#
# nbshell hat keinen eigenen -- Quickshell hat keine Anbindung an polkit --,
# also wird ein vorhandener eingeschaltet. `hyprpolkitagent` ist die naechste
# Wahl: Qt/QML wie die Shell selbst, in `extra`, laeuft unter jedem
# wlroots-Kompositor und bringt seine eigene User-Unit mit.
POLKIT_UNITS="hyprpolkitagent.service polkit-gnome-authentication-agent-1.service lxqt-policykit-agent.service mate-polkit.service"

polkit_unit() {
    local unit
    for unit in $POLKIT_UNITS; do
        systemctl --user cat "$unit" >/dev/null 2>&1 && { echo "$unit"; return 0; }
    done
    return 1
}

polkit_running() {
    # Der Agent meldet sich als org.freedesktop.PolicyKit1.AuthenticationAgent
    # bei polkitd an -- am Bus sieht man ihn aber nur an seinem Prozess.
    pgrep -f 'polkit.*(agent|Agent)|polkit-gnome|lxqt-policykit|hyprpolkitagent' >/dev/null 2>&1
}

polkit_on() {
    local unit
    if unit="$(polkit_unit)"; then
        systemctl --user enable --now "$unit" >/dev/null 2>&1 \
            && echo "  polkit: $unit is running and starts at login" \
            || echo "  polkit: $unit could not be started"
    else
        echo "  polkit: no agent installed -- privileged prompts will fail"
        echo "          silently. Install with: sudo pacman -S hyprpolkitagent"
    fi
}

polkit_status() {
    local unit
    if unit="$(polkit_unit)"; then
        printf 'Agent            %s (%s)\n' "$unit" "$(systemctl --user is-active "$unit" 2>/dev/null)"
    elif polkit_running; then
        printf 'Agent            laeuft (ohne Unit, von Hand gestartet)\n'
    else
        printf 'Agent            keiner -- pacman -S hyprpolkitagent\n'
    fi
}

switch_on() {
    echo "Enabling nbshell:"
    local compositor
    compositor="$(compositor_name)"
    if [ "$compositor" = "niri" ] && [ ! -f "$NIRI_DIR/$TAKEOVER" ]; then
        echo "  $TAKEOVER is missing -- run ./install.sh first." >&2
        return 1
    fi
    # Reine Migrationshilfe: auf neuen Installationen existiert diese Unit
    # nicht. Ein Altbestand darf dem Notification-Bus nicht im Weg stehen.
    if systemctl --user cat dms.service >/dev/null 2>&1; then
        systemctl --user stop dms.service 2>/dev/null && echo "  Old DMS: stopped"
        systemctl --user reset-failed dms.service 2>/dev/null || true
        systemctl --user mask dms.service >/dev/null 2>&1 && echo "  Old DMS: masked"
    fi
    if [ "$compositor" = "niri" ]; then
        niri_include || true
    else
        echo "  umbriel: include \"nbshell.toml\" from ~/.config/umbriel/config.toml"
    fi
    ipc notify server on >/dev/null && echo "  nbshell: notification server enabled"
    ipc wallpaper on >/dev/null && echo "  nbshell: wallpaper enabled"
    ghostty_theme nbcolors
    alacritty_theme nb-theme.toml
    polkit_on
    autostart_on
}

switch_off() {
    echo "Disabling nbshell:"
    ipc notify server off >/dev/null && echo "  nbshell: notification server disabled"
    ipc wallpaper off >/dev/null && echo "  nbshell: wallpaper disabled"
    autostart_off
    niri_exclude || true
    systemctl --user stop nbshell.service 2>/dev/null || true
}

switch_status() {
    local compositor
    compositor="$(compositor_name)"
    printf 'Compositor         %s\n' "$compositor"
    if systemctl --user cat dms.service >/dev/null 2>&1; then
        printf 'Legacy DMS          %s\n' "$(systemctl --user is-active dms.service 2>/dev/null; systemctl --user is-enabled dms.service 2>/dev/null | tr '\n' ' ')"
    fi
    printf 'Notification server %s\n' "$(busctl --user list 2>/dev/null | awk '/^org.freedesktop.Notifications/ {print $2" ("$3")"}')"
    if [ "$compositor" = "umbriel" ]; then
        printf 'Umbriel assets     %s\n' "$([ -f "${XDG_CONFIG_HOME:-$HOME/.config}/umbriel/nbshell.toml" ] && echo installed || echo missing)"
    else
        printf 'Niri bindings      %s\n' "$([ -f "$NIRI_DIR/config.kdl" ] && grep -qF "$INCLUDE_LINE" "$NIRI_DIR/config.kdl" && echo "nbshell" || echo "not included")"
        printf 'Window borders     %s\n' "$([ -f "$NIRI_DIR/config.kdl" ] && grep -qF "$COLORS_LINE" "$NIRI_DIR/config.kdl" && echo "nbshell" || echo "not included")"
    fi
    printf 'nbshell autostart  %s (%s)\n' "$(systemctl --user is-enabled nbshell.service 2>/dev/null || echo off)" "$(systemctl --user is-active nbshell.service 2>/dev/null || true)"
    polkit_status
}

usage() {
    cat <<'USAGE'
nbshell -- an independent Quickshell desktop shell for Wayland compositors

  nbshell start [-d]        start the shell (-d runs in the background)
  nbshell stop              stop the shell
  nbshell restart           restart the shell

  nbshell bar               full-width bar
  nbshell island            floating island that collapses to the clock
  nbshell pill              floating island that stays expanded
  nbshell mode toggle       cycle through all three modes
  nbshell edge top|bottom|toggle
                            set or toggle the screen edge
  nbshell open|close|toggle  hold the island open or closed

  nbshell theme             show the active theme
  nbshell theme <name>      switch theme
  nbshell themes            list installed themes
  nbshell theme install [--force] <url|directory>
                            install an Omarchy theme; --force replaces it
  nbshell theme remove <name>
                            remove an installed theme
  nbshell theme update      update themes installed from Git
  nbshell picker            open the theme picker
  nbshell next | prev       select the next or previous theme

  nbshell accent            show the active accent role and choices
  nbshell accent green      use a color from the active theme
  nbshell accent theme      use the theme's default accent

  nbshell widget            list per-module appearance overrides
  nbshell widget battery display icon
                            full | icon | text | auto
  nbshell widget clock style plain
                            box | bracket | plain | auto
  nbshell widget updates color red
                            a theme color; auto follows the global setting
  nbshell widget updates reset
                            reset module color override
  nbshell widget reset all  reset all widget overrides

  nbshell audio up|down     change volume
  nbshell audio mute        toggle mute
  nbshell audio <percent>   set volume
  nbshell audio status      show volume and active sink
  nbshell audio panel       open mixer and device list

  nbshell launcher          open the application launcher (alias: run)
  nbshell launcher search <query>
                            prefill a provider query (# window, ^ clipboard,
                            @ files, = calculator)
  nbshell palette           open the command-only launcher
  nbshell find <text>       show matching launcher entries
  nbshell commands [text]   list command-palette entries
  nbshell commands --json   print the CLI catalog for agents and scripts
  nbshell command <text>    run the best command match

  nbshell notify            show notification status
  nbshell notify toggle     open the notification center
  nbshell notify dnd        toggle do not disturb
  nbshell notify clear      dismiss all notifications
  nbshell notify server on|off
                            manage org.freedesktop.Notifications ownership

  nbshell modules           arrange bar modules
  nbshell settings          open appearance and behavior settings
  nbshell display           open display management (Niri-first)
  nbshell display status    list connected outputs as JSON
  nbshell display set <output> mode|scale|transform|enabled <value>
                            configure display properties
  nbshell display place <output> left|right|above|below <reference>
                            position connected displays
  nbshell ui-gallery        preview the shared nbshell component language
  nbshell update            check nbshell and the Umbriel stack
  nbshell update install    verify and install the latest nbshell release
  nbshell update umbriel    build, test and install the Umbriel stack
  nbshell update all        install all available desktop updates
  nbshell updates           system packages: status, check, list, run
  nbshell ai                open the Agent Center (also: usage, refresh)
  nbshell agent list [--json]
                            list installed and supported coding agents
  nbshell agent default [id]
                            show or select the default agent
  nbshell agent launch [id] [--project <path>]
                            start an agent in a project terminal
  nbshell agent quick [--project <path>]
                            open the default agent in a floating terminal
  nbshell agent prompt <text>
                            start the default agent with a prompt
  nbshell agent profile [safe|balanced|autonomous]
                            show or set the agent approval profile
  nbshell agent model-profile [local|cloud|private|fast|strong]
                            show or set the model routing profile
  nbshell agent model <profile> <provider/model>
                            set the concrete model used by a routing profile
  nbshell agent hermes-provider [codex|claude|gemini]
                            select the Hermes Hub model lane
  nbshell agent hermes-mode [restricted|research|workspace|trusted]
                            select the Hermes Hub capability boundary
  nbshell agent hermes-broker [status|setup|test|remove]
                            manage the bounded advisory and transaction broker
  nbshell agent hermes-job <create|list|review|apply|install|push|reject>
                            manage isolated, human-approved provider jobs
  nbshell agent hermes-team <list|pause|resume|cancel|apply|install|push|reject>
                            manage supervised multi-agent team sessions

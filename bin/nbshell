                            approve one privileged action with a paired phone

Legacy German aliases remain available for existing configurations.
All other arguments are passed directly to Quickshell:
  nbshell log, nbshell ipc show, ...
USAGE
}

cmd="${1:-}"
[ $# -gt 0 ] && shift || true

case "$cmd" in
    ""|-h|--help|help)
        usage
        ;;
    -V|--version|version)
        printf 'nbshell %s\n' "$(cat "$VERSION_FILE" 2>/dev/null || printf 'development')"
        ;;
    start)
        exec "$QS" -c "$CONFIG_NAME" "$@"
        ;;
    stop)
        exec "$QS" -c "$CONFIG_NAME" kill
        ;;
    restart)
        # Duplikatsicher: laeuft nbshell als systemd-Dienst, uebernimmt der die
        # Einzel-Instanz-Garantie. Frueher liess `qs kill` detachte Instanzen
        # ueberleben und `-d` startete eine ZWEITE neben dem Dienst -> mehrere
        # Bars. Deshalb erst dem Dienst den Vortritt geben.
        if systemctl --user is-enabled nbshell.service >/dev/null 2>&1 \
           || systemctl --user is-active nbshell.service >/dev/null 2>&1; then
            exec systemctl --user restart nbshell.service
        fi
        # Fallback ohne Dienst: ALLE nbshell-qs-Instanzen sicher beenden.
        "$QS" -c "$CONFIG_NAME" kill 2>/dev/null || true
        for pid in $(pgrep -x qs 2>/dev/null); do
            grep -qz -- "$CONFIG_NAME" "/proc/$pid/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null
        done
        sleep 0.4
        exec "$QS" -c "$CONFIG_NAME" -d
        ;;
    bar|island|pill)
        ipc bar mode "$cmd" >/dev/null && echo "$cmd"
        ;;
    mode|edge)
        ipc bar "$cmd" "${1:-toggle}"
        ;;
    open|close|toggle)
        ipc bar "$cmd"
        ;;
    theme)
        case "${1:-}" in
            # `current` MUSS hier stehen: sonst landet es im Zweig darunter
            # und setzt das Theme auf den Namen "current".
            ""|current) ipc theme current ;;
            install|remove|update|list)
                # Nach dem Installieren die Liste neu einlesen, sonst taucht
                # das Theme erst nach einem Neustart in der Auswahl auf.
                "$THEME_TOOL" "$@" && ipc themes reload >/dev/null 2>&1
                ;;
            write) ipc theme write ;;
            *) ipc theme set "$1" ;;
        esac
        ;;
    themes)
        # Aus der laufenden Shell, damit der Stern stimmt; ohne sie vom Datei-
        # system.
        if ! ipc themes list 2>/dev/null; then
            for d in "$CONFIG_DIR"/themes/*/; do printf '   %s\n' "$(basename "$d")"; done
        fi
        ;;
    picker)
        ipc themes toggle
        ;;
    accent|akzent)
        ipc theme accent "${1:-status}"
        ;;
    widget|baustein)
        case "${1:-list}" in
            ""|list)  ipc widget list ;;
            reset)    shift; ipc widget reset "${1:-all}" ;;
            *)        ipc widget set "${1:?module is required}" "${2:?property is required (display|style|color)}" "${3:?value is required}" ;;
        esac
        ;;
    audio)
        case "${1:-status}" in
            up|down|mute|micmute|status|panel|tools) ipc audio "${1:-status}" ;;
            *) ipc audio set "$1" ;;
        esac
        ;;
    launcher|run)
        if [ "${1:-}" = "search" ]; then
            shift
            ipc launcher search "${*:-}"
        else
            ipc launcher "${1:-toggle}"
        fi
        ;;
    calculator|calc)
        if [ "${1:-}" = "evaluate" ]; then
            ipc calculator evaluate "${2:?expression is required}"
        else
            ipc calculator "${1:-toggle}"
        fi
        ;;
    store|library)
        ipc store "${1:-toggle}"
        ;;
    system-report|report)
        python3 "$SYSTEM_REPORT_TOOL" "$@"
        ;;
    memory-guard|oomd)
        bash "$MEMORY_GUARD_TOOL" "$@"
        ;;
    demo)
        bash "$DEMO_TOOL" "$@"
        ;;
    whatsapp)
        case "${1:-open}" in
            setup|auth|status) bash "$OMAWHATSAPP_TOOL" "${1:-status}" ;;
            provider) bash "$OMAWHATSAPP_TOOL" provider "${2:?provider is required}" ;;
            demo) ipc plugin openWithPayload omawhatsapp '{"demo":true}' | sed 's/^omawhatsapp:/whatsapp:/' ;;
            open|toggle)
                if [ "$(bash "$OMAWHATSAPP_TOOL" current 2>/dev/null)" = omawhatsapp ]; then
                    ipc plugin toggle omawhatsapp | sed 's/^omawhatsapp:/whatsapp:/'
                else
                    prettyzap --show
                fi
                ;;
            *) echo "Usage: nbshell whatsapp setup|auth|status|demo|provider whatsapp|prettyzap" >&2; exit 2 ;;
        esac
        ;;
    aether)
        bash "$AETHER_TOOL" "${1:-status}"
        ;;
    palette)
        ipc launcher palette
        ;;
    find)
        ipc launcher find "${1:?search text is required}"
        ;;
    befehle|commands)
        if [ "${1:-}" = "--json" ]; then
            usage | python3 -c '
import json, re, sys
rows = []
pending_cmd = None
pending_summary = []

def flush():
    global pending_cmd, pending_summary
    if pending_cmd:
        summary_text = " ".join(" ".join(pending_summary).split())
        if pending_cmd == "nbshell commands --json":
            summary_text = "Print this machine-readable CLI catalog"
        rows.append({"command": pending_cmd, "summary": summary_text})
        pending_cmd = None
        pending_summary = []

for line in sys.stdin:
    stripped = line.rstrip()
    if not stripped or stripped.startswith("nbshell --") or "Legacy German aliases" in stripped or "All other arguments" in stripped:
        flush()
        continue
    cmd_match = re.match(r"^  (nbshell(?: [^\s]+)*)(?:\s{2,}(.+))?$", stripped)
    if cmd_match:
        flush()
        cmd, inline_summary = cmd_match.groups()
        if cmd == "nbshell log, nbshell ipc show, ...":
            continue
        pending_cmd = cmd
        if inline_summary and inline_summary.strip():
            pending_summary.append(inline_summary.strip())
    elif pending_cmd and re.match(r"^\s{4,}\S", stripped):
        pending_summary.append(stripped.strip())
    else:
        flush()

flush()
print(json.dumps({"schemaVersion": 1, "commands": rows}, indent=2))'
        else
            ipc launcher commands "${1:-}"
        fi
        ;;
    befehl|command)
        ipc launcher exec "${1:?Command name is required}"
        ;;
    switch)
        case "${1:-status}" in
            on) shift; switch_on "$@" ;;
            off) switch_off ;;
            *) switch_status ;;
        esac
        ;;
    cursor|zeiger)
        if [ $# -eq 0 ]; then
            cursor_status
        else
            cursor_set "$@"
        fi
        ;;
    text)
        text_size "${1:-}"
        ;;
    nearby|naehe)
        case "${1:-list}" in
            scan)   ipc nearby scan ;;
            list|"") ipc nearby list ;;
            send)   shift
                    datei="$(realpath -e "${1:?file is required}")" || exit 1
                    if [ -n "${2:-}" ]; then ipc nearby sendTo "$datei" "$2"; else ipc nearby send "$datei"; fi ;;
            *)      ipc nearby status ;;
        esac
        ;;
    codec)
        # Ohne Argument die Auskunft, mit Argument umschalten:
        #   nbshell codec           -> AAC  (es ginge …)
        #   nbshell codec beste     -> den hoechstplatzierten nehmen
        #   nbshell codec sbc-xq    -> einen bestimmten
        ipc audio codec "${1:-}"
        ;;
    keys|tasten)
        case "${1:-fenster}" in
            # Die Liste kommt DIREKT aus dem Skript, nicht ueber die Shell:
            # sie liest niris Konfiguration, nicht den Zustand der Shell -- und
            # soll deshalb auch antworten, wenn nbshell gar nicht laeuft.
            liste|list)
                python3 "$KEYS_TOOL" | python3 -c '
import json, sys
d = json.load(sys.stdin)
if not d.get("ok"):
    sys.exit(d.get("grund", "unbekannt"))
# Nach Gruppen sortiert wie im Fenster, nicht in der Reihenfolge der
# Konfiguration -- sonst steht dieselbe Ueberschrift viermal da.
ordnung = ["Applications", "Windows", "Workspaces", "Displays",
           "Audio and display", "Capture", "Session", "Other"]
d["binds"].sort(key=lambda b: ordnung.index(b["gruppe"]) if b["gruppe"] in ordnung else len(ordnung))
gruppe = None
for b in d["binds"]:
    if b["gruppe"] != gruppe:
        gruppe = b["gruppe"]
        print()
        print(gruppe.upper())
    print("  %-26s %s" % (b["taste"], b["text"]))
' ;;
            neu|reload)      ipc keys reload ;;
            *)               ipc keys toggle ;;
        esac
        ;;
    music|musik|media|medien)
        case "${1:-open}" in
            status|pause|next|previous) ipc music "${1}" ;;
            toggle|fenster|window) ipc music toggle ;;
            *) ipc music open ;;
        esac
        ;;
    ton|audio-restore)
        case "${1:-zurueck}" in
            panel|toggle) ipc audio panel ;;
            up|down|mute|micmute|status) ipc audio "$1" ;;
            set) ipc audio set "${2:?percent is required}" ;;
            ''|*[!0-9]*) ipc audio zurueck ;;
            *) ipc audio set "$1" ;;
        esac
        ;;
    qr)
        ipc net qr
        ;;
    speed|speedtest)
        ipc net speed
        ;;
    wach|awake|caffeine|koffein)
        ipc idle caffeine "${1:-toggle}"
        ;;
    idle|leerlauf)
        case "${1:-status}" in
            on|an)   ipc idle on ;;
            off|aus) ipc idle off ;;
            *)       ipc idle status ;;
        esac
        ;;
    saver|schoner)
        ipc idle saver
        ;;
    polkit)
        case "${1:-status}" in
            on) polkit_on ;;
            *) polkit_status ;;
        esac
        ;;
    auth|phone-auth)
        auth_tool=/usr/lib/nbshell/nbshell_phone_auth.py
        case "${1:-status}" in
            approve-next|next)
                scope="${2:-system}"
                case "$scope" in system|sudo|polkit-1) ;; *) die "usage: nbshell auth approve-next [system|sudo|polkit-1]" ;; esac
                [ -x "$auth_tool" ] || die "Phone authentication is not installed."
                echo "Waiting for biometric approval on the paired phone …"
                if "$auth_tool" authorize-next --scope "$scope" --timeout 60 --grant-ttl 30 >/dev/null; then
                    echo "Approved. The next matching action is unlocked for 30 seconds."
                else
                    die "Phone approval expired or was declined."
                fi
                ;;
            status)
                if systemctl is-active --quiet nbshell-phone-auth.service 2>/dev/null \
                    && [ -S /run/nbshell-auth/control.sock ]; then
                    echo "Phone authentication broker: ready"
                else
                    echo "Phone authentication broker: unavailable"
                    exit 1
                fi
                ;;
            *) die "usage: nbshell auth [status|approve-next [system|sudo|polkit-1]]" ;;
        esac
        ;;
    state)
        ipc state dump
        ;;
    settings)
        ipc settings toggle
        ;;
    display|displays|monitor|monitors)
        case "${1:-open}" in
            open|toggle) ipc displays toggle ;;
            *) python3 "$DISPLAY_TOOL" "$@" ;;
        esac
        ;;
    ui-gallery|gallery)
        ipc uiGallery toggle
        ;;
    modules)
        ipc settings modules
        ;;
    plugin-store)
        ipc plugins store
        ;;
    plugin-manager|plugin-dev|plugin-diagnose)
        ipc plugins developer
        ;;
    updates)
        ipc updates "${1:-status}"
        ;;
    upstream-audit|source-audit)
        python3 "$RUNTIME_DIR/scripts/upstream-audit.py" "$@"
        ;;
    update|self-update)
        case "${1:-check}" in
            check|status|"")
                python3 "$SHELL_UPDATE_TOOL" check --channel "${2:-beta}"
                python3 "$UMBRIEL_UPDATE_TOOL" check
                ;;
            install|run)     python3 "$SHELL_UPDATE_TOOL" install --channel "${2:-beta}" ;;
            umbriel|compositor) python3 "$UMBRIEL_UPDATE_TOOL" install ;;
            all)
                python3 "$SHELL_UPDATE_TOOL" install --channel "${2:-beta}"
                python3 "$UMBRIEL_UPDATE_TOOL" install
                ;;
            notes)           ipc shellUpdate notes ;;
            *) echo "Usage: nbshell update [check|install|umbriel|all|notes] [beta|stable]" >&2; exit 2 ;;
        esac
        ;;
    ai)
        case "${1:-center}" in
            center|open|toggle) ipc agentCenter toggle ;;
            usage|status|refresh) ipc ai "${1:-status}" ;;
            attention) ipc agentCenter attention "${2:-finished}" "${3:-}" ;;
            *) ipc agentCenter toggle ;;
        esac
        ;;
    agent|agents)
        sub="${1:-status}"
        [ $# -gt 0 ] && shift || true
        case "$sub" in
            center|open) ipc agentCenter toggle ;;
            *) python3 "$AGENT_TOOL" "$sub" "$@" ;;
        esac
        ;;
    capture)
        ipc capture "${1:-menu}"
        ;;
    procs|top)
        ipc procs "${1:-toggle}"
        ;;
    menu)
        ipc menu "${1:-toggle}"
        ;;
    dashboard|dash)
        if [ "${1:-}" = "view" ]; then
            ipc dashboard view "${2:-heute}"
        else
            ipc dashboard "${1:-toggle}"
        fi
        ;;
    gaming|games)
        bash "$GAMING_TOOL" "${1:-status}" "${2:-}"
        ;;
    grid)
        if [ "$(compositor_name)" = "umbriel" ]; then
            case "${1:-toggle}" in
                toggle) umbriel msg workspace-set-layout:toggle ;;
                *) echo "Umbriel currently supports: nbshell grid toggle" >&2; exit 2 ;;
            esac
        else
            python3 "$GRID_TOOL" "${1:-toggle}" "${2:-}"
        fi
        ;;
    compositor)
        case "${1:-status}" in
            status) printf '%s\n' "$(compositor_name)" ;;
            nested|test-umbriel) bash "$UMBRIEL_NESTED_TOOL" ;;
            *) echo "Usage: nbshell compositor [status|nested]" >&2; exit 2 ;;
        esac
        ;;
    bongo|cat)
        case "${1:-status}" in
            on|enable|an) ipc bongo enable ;;
            off|disable|aus) ipc bongo disable ;;
            allow|erlauben) ipc bongo allowInput ;;
            revoke|entziehen) ipc bongo revokeInput ;;
            test) ipc bongo test ;;
            toggle) ipc bongo toggle ;;
            resize) ipc bongo resize "${2:?width in pixels is required}" ;;
            *) ipc bongo status ;;
        esac
        ;;
    cal|calendar)
        ipc calendar "${1:-toggle}"
        ;;
    plugins|plugin)
        # `list` fragt die laufende Shell (die kennt auch die eingebauten
        # Bausteine); alles andere greift auf die Verzeichnisse zu und geht
        # deshalb direkt an das Skript -- es muss auch dann gehen, wenn die
        # Shell gerade nicht laeuft.
        case "${1:-list}" in
            add|remove|rm|update|diff|validate|design-check|audit|new|enable|disable|dir)
                "$PLUGIN_TOOL" "$@"
                ;;
            *)
                ipc plugins "${1:-list}"
                ;;
        esac
        ;;
    popout)
        ipc popout toggle "${1:?name is required}"
        ;;
    extension)
        ipc plugin "${1:-toggle}" "${2:?plugin ID is required}"
        ;;
    translate|uebersetzen)
        ipc plugin toggle shaun.quick-translate
        ;;
    emoji|emojis)
        ipc emoji "${1:-toggle}"
        ;;
    hub|integrations)
        ipc hub "${1:-toggle}"
        ;;
    clip|clipboard)
        ipc clipboard "${1:-list}"
        ;;
    todo|aufgaben)
        case "${1:-list}" in
            toggle|open) ipc todo toggle ;;
            list|"")     ipc todo list ;;
            sync)        ipc todo sync ;;
            clear)       ipc todo clear ;;
            status)      ipc todo status ;;
            done)        ipc todo done "${2:?number is required}" ;;
            drop|rm)     ipc todo drop "${2:?number is required}" ;;
            add)
                shift
                [ $# -gt 0 ] || { echo "text is required" >&2; exit 2; }
                # Alle Wörter als EIN Eintrag: `nbshell todo add Milch kaufen`
                # soll nicht zwei Aufgaben anlegen.
                text="$*"
                # Dieselbe Kodierung wie bei `set`: Quickshells IPC-Aufrufer
                # zerlegt Kommas, Semikola und eckige Klammern zu Argumenten.
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc todo add "$text"
                ;;
            *)
                # Ohne Unterbefehl ist alles Weitere der Text -- der kuerzeste
                # Weg zum Eintragen: `nbshell todo Milch kaufen`
                text="$*"
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc todo add "$text"
                ;;
        esac
        ;;
    notes|note|notizen)
        case "${1:-new}" in
            new|toggle|"") ipc notes newNote ;;
            list)          ipc notes list ;;
            open|edit)     ipc notes open "${2:?number is required}" ;;
            sync)          ipc notes sync ;;
            status)        ipc notes status ;;
            *)             echo "Usage: nbshell notes [new|list|open <n>|sync|status]" >&2; exit 2 ;;
        esac
        ;;
    habits|gewohnheiten)
        case "${1:-list}" in
            toggle|open) ipc habits toggle ;;
            list|"")     ipc habits list ;;
            sync)        ipc habits sync ;;
            status)      ipc habits status ;;
            done)        ipc habits done "${2:?number is required}" ;;
            inc)         ipc habits inc "${2:?number is required}" "${3:-1}" ;;
            drop|rm)     ipc habits drop "${2:?number is required}" ;;
            add)
                shift
                [ $# -gt 0 ] || { echo "text is required (z.B. joggen // workout)" >&2; exit 2; }
                text="$*"
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc habits add "$text"
                ;;
            *)
                text="$*"
                text="${text//%/%25}"
                text="${text//,/%2C}"
                text="${text//;/%3B}"
                text="${text//[/%5B}"
                text="${text//]/%5D}"
                ipc habits add "$text"
                ;;
        esac
        ;;
    battery|bat)
        case "${1:-status}" in
            status|"") ipc battery status ;;
            *) ipc battery profile "$1" ;;
        esac
        ;;
    power)
        case "${1:-menu}" in
            menu|lock|logout|suspend) ipc power "${1:-menu}" ;;
            display-off)
                # A compositor-native keybind fires before its keys are
                # released. Umbriel treats those release events as activity
                # and immediately wakes a freshly powered-off output, so let
                # the chord settle before sending the DPMS action.
                sleep 0.35
                # Umbriel intentionally gives spawned keybind commands a
                # minimal environment. Reconstruct its documented per-display
                # socket path when XDG_RUNTIME_DIR/UMBRIEL_SOCKET are absent.
                local_runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
                local_wayland="${WAYLAND_DISPLAY:-wayland-0}"
                local_umbriel_socket="${UMBRIEL_SOCKET:-$local_runtime/umbriel-$local_wayland.sock}"
                local_umbriel_bin="$(command -v umbriel 2>/dev/null || true)"
                [ -n "$local_umbriel_bin" ] || local_umbriel_bin="$HOME/.local/bin/umbriel"
                if [ -x "$local_umbriel_bin" ] \
                    && [ -S "$local_umbriel_socket" ] \
                    && XDG_RUNTIME_DIR="$local_runtime" UMBRIEL_SOCKET="$local_umbriel_socket" \
                        "$local_umbriel_bin" msg dpms-off 2>/dev/null; then
                    :
                else
                    /usr/bin/niri msg action power-off-monitors
                fi
                ;;
            *) ipc power menu ;;
        esac
        ;;
    media)
        ipc media "${1:-status}"
        ;;
    dictate)
        if command -v voxtype >/dev/null 2>&1; then
            voxtype record toggle
        else
            notify-send -u normal "Dictation is not installed" "Install the optional voxtype-bin package."
        fi
        ;;
    pip)
        "$PIP_TOOL" "${1:-status}"
        ;;
    browser-theme)
        "$BROWSER_THEME_TOOL" "${1:-status}"
        ;;
    greeter)
        case "${1:-}" in
            install) "$GREETER_SETUP" install "${2:-orbital}" "${3:-}" ;;
            sync) "$GREETER_SETUP" sync ;;
            preview) "$GREETER_SETUP" preview ;;
            status) "$GREETER_SETUP" status ;;
            activate) "$GREETER_SETUP" activate "${2:-}" ;;
            *) die "usage: nbshell greeter install orbital|regreet|sync|preview|status|activate orbital|regreet" ;;
        esac
        ;;
    video-trimmer|trim-video)
        "$OMACUT_TOOL" "${1:-status}"
        ;;
    notify)
        case "${1:-status}" in
            toggle|center|dnd|clear|status|list) ipc notify "${1:-status}" ;;
            server) ipc notify server "${2:-toggle}" ;;
            *) ipc notify status ;;
        esac
        ;;
    tray)
        case "${1:-list}" in
            toggle) ipc tray toggle ;;
            *) ipc tray list ;;
        esac
        ;;
    osd)
        ipc osd "${1:-status}"
        ;;
    control)
        ipc control "${1:-toggle}"
        ;;
    brightness)
        case "${1:-}" in
            up|down) ipc brightness "$1" ;;
            *) ipc brightness set "${1:?percent is required}" ;;
        esac
        ;;
    wallpaper)
        case "${1:-current}" in
            on|off|toggle|current|pick|list|theme) ipc wallpaper "${1:-current}" ;;
            *) ipc wallpaper set "$1" ;;
        esac
        ;;
    next|prev)
        ipc themes "$cmd"
        ;;
    get)
        ipc config get "${1:?key is required}"
        ;;
    set)
        # Quickshells IPC-Aufrufer liest eckige Klammern als ARGUMENTLISTE und
        # zerlegt ausserdem an Kommas und Semikola: aus '["a","b"]' werden drei
        # Argumente, und der Aufruf scheitert mit "2 required but 3 were
        # provided". Steuerzeichen helfen nicht -- 0x1F ist sein eigenes
        # Trennzeichen. Also gehen die vier Zeichen prozentkodiert ueber die
        # Leitung; shell.qml dreht das zurueck.
        key="${1:?key is required}"
        value="${2:?value is required}"
        value="${value//%/%25}"
        value="${value//,/%2C}"
        value="${value//;/%3B}"
        value="${value//[/%5B}"
        value="${value//]/%5D}"
        ipc config set "$key" "$value"
        ;;
    config)
        ipc config dump
        ;;
    status)
        ipc bar status
        ;;
    *)
        exec "$QS" -c "$CONFIG_NAME" "$cmd" "$@"
        ;;
esac

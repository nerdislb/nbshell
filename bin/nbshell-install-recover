#!/usr/bin/env bash
# Independent recovery endpoint for an interrupted atomic shell switch.
set -euo pipefail

SHELL_DIR="${1:?runtime path required}"
ROLLBACK_DIR="${2:?rollback path required}"
MODE="${3:-restart}"
TRANSACTION_DIR="${4:-}"
COMMAND_PATH="${5:-${XDG_BIN_HOME:-$HOME/.local/bin}/nbshell}"
STAGED_DIR="${6:-}"
PARENT_DIR="$(dirname "$SHELL_DIR")"
recovery_failed=0

recover_command() {
    "$@" || recovery_failed=1
}

expected_transaction_path() {
    local key=$1 suffix
    local config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
    local data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
    local cache_home="${XDG_CACHE_HOME:-$HOME/.cache}"
    local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/nbshell"
    local bin_dir="${XDG_BIN_HOME:-$HOME/.local/bin}"
    local unit_dir="$config_home/systemd/user"
    case "$key" in
        share-nbshell) printf '%s\n' "$data_home/nbshell" ;;
        themes) printf '%s\n' "$config_home/nbshell/themes" ;;
        command) printf '%s\n' "$bin_dir/nbshell" ;;
        recovery-command) printf '%s\n' "$bin_dir/nbshell-install-recover" ;;
        aether-hook) printf '%s\n' "$config_home/aether/custom/nbshell" ;;
        app-shell) printf '%s\n' "$data_home/applications/dev.nerdi.nbshell.desktop" ;;
        app-calculator) printf '%s\n' "$data_home/applications/dev.nerdi.nbshell.Calculator.desktop" ;;
        old-mail-config) printf '%s\n' "$config_home/omarchy-gmail" ;;
        old-mail-cache) printf '%s\n' "$cache_home/omarchy-gmail" ;;
        mail-config) printf '%s\n' "$config_home/omamail" ;;
        mail-cache) printf '%s\n' "$cache_home/omamail" ;;
        niri-config) printf '%s\n' "$config_home/niri/config.kdl" ;;
        niri-config-backup) printf '%s\n' "$config_home/niri/config.kdl.before-nbshell-umbriel-only" ;;
        niri-takeover) printf '%s\n' "$config_home/niri/nbshell-takeover.kdl" ;;
        niri-outputs) printf '%s\n' "$config_home/niri/nbshell-outputs.kdl" ;;
        niri-cursor) printf '%s\n' "$config_home/niri/nbshell-cursor.kdl" ;;
        niri-colors) printf '%s\n' "$config_home/niri/nbshell-colors.kdl" ;;
        niri-unit) printf '%s\n' "$unit_dir/niri.service.d/nbshell.conf" ;;
        niri-grid-unit) printf '%s\n' "$unit_dir/niri.service.d/nbshell-grid-atomic.conf" ;;
        niri-atomic) printf '%s\n' "$HOME/.local/lib/nbshell/niri-atomic" ;;
        grid-json) printf '%s\n' "$state_dir/grid-layout.json" ;;
        grid-lock) printf '%s\n' "$state_dir/grid-layout.lock" ;;
        grid-pid) printf '%s\n' "$state_dir/grid-layout.pid" ;;
        grid-backend) printf '%s\n' "$state_dir/grid-layout-backend" ;;
        skill-.agents) printf '%s\n' "$HOME/.agents/skills/nbshell" ;;
        skill-.claude) printf '%s\n' "$HOME/.claude/skills/nbshell" ;;
        skill-.codex) printf '%s\n' "$HOME/.codex/skills/nbshell" ;;
        skill-agent) printf '%s\n' "$HOME/.pi/agent/skills/nbshell" ;;
        skill-gemini) printf '%s\n' "$HOME/.gemini/skills/nbshell" ;;
        config.json) printf '%s\n' "$config_home/nbshell/config.json" ;;
        ytmusic-runtime) printf '%s\n' "$HOME/.local/lib/omarchy-ytmusic" ;;
        umbriel-main) printf '%s\n' "$config_home/umbriel/nbshell.toml" ;;
        umbriel-motion) printf '%s\n' "$config_home/umbriel/nbshell-motion.toml" ;;
        umbriel-nested) printf '%s\n' "$config_home/umbriel/nbshell-nested.toml" ;;
        umbriel-outputs) printf '%s\n' "$config_home/umbriel/nbshell-outputs.toml" ;;
        umbriel-cursor) printf '%s\n' "$config_home/umbriel/nbshell-cursor.toml" ;;
        umbriel-overview) printf '%s\n' "$config_home/umbriel/nbshell-overview.toml" ;;
        umbriel-colors) printf '%s\n' "$config_home/umbriel/nbshell-colors.toml" ;;
        umbriel-config) printf '%s\n' "$config_home/umbriel/config.toml" ;;
        plugin-*)
            suffix=${key#plugin-}
            [[ $suffix =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 1
            printf '%s\n' "$config_home/nbshell/plugins/$suffix"
            ;;
        unit-*)
            suffix=${key#unit-}
            [[ $suffix =~ ^[A-Za-z0-9][A-Za-z0-9@_.:-]*\.(service|timer)$ ]] || return 1
            printf '%s\n' "$unit_dir/$suffix"
            ;;
        *) return 1 ;;
    esac
}

rollback_is_runtime() {
    [ -d "$ROLLBACK_DIR" ] && [ -f "$ROLLBACK_DIR/shell.qml" ]
}

rollback_has_contents() {
    [ -d "$ROLLBACK_DIR" ] && [ -n "$(find "$ROLLBACK_DIR" -mindepth 1 -print -quit)" ]
}

runtime_identity() {
    stat -Lc '%d:%i' -- "$1" 2>/dev/null
}

runtime_matches_original() {
    local expected actual
    [ -f "$TRANSACTION_DIR/original-runtime-identity" ] || return 1
    IFS= read -r expected <"$TRANSACTION_DIR/original-runtime-identity"
    actual="$(runtime_identity "$1")" || return 1
    [ -n "$expected" ] && [ "$actual" = "$expected" ]
}

discard_empty_reservation() {
    if [ -d "$ROLLBACK_DIR" ] && [ -z "$(find "$ROLLBACK_DIR" -mindepth 1 -print -quit)" ]; then
        rmdir -- "$ROLLBACK_DIR"
    fi
}

restore_runtime_from_backup() {
    if [ -z "$STAGED_DIR" ] \
            || ! rm -rf -- "$STAGED_DIR" \
            || ! cp -a -- "$ROLLBACK_DIR" "$STAGED_DIR"; then
        recovery_failed=1
        return 1
    fi
    if [ -e "$SHELL_DIR" ] || [ -L "$SHELL_DIR" ]; then
        if ! mv --exchange -T -- "$SHELL_DIR" "$STAGED_DIR"; then
            recovery_failed=1
            return 1
        fi
        recover_command rm -rf -- "$STAGED_DIR"
        return 0
    fi
    if mv -T -- "$STAGED_DIR" "$SHELL_DIR"; then
        return 0
    fi
    recovery_failed=1
    return 1
}

restore_transaction_paths() {
    local manifest="$TRANSACTION_DIR/paths"
    local state key path expected index
    local -a states=() keys=() paths=()
    [ -f "$manifest" ] || return 0
    while IFS= read -r -d '' state; do
        if ! IFS= read -r -d '' key || ! IFS= read -r -d '' path; then
            recovery_failed=1
            break
        fi
        if [[ ! $key =~ ^[A-Za-z0-9._-]+$ ]] \
                || ! expected="$(expected_transaction_path "$key")" \
                || [ "$path" != "$expected" ]; then
            recovery_failed=1
            continue
        fi
        states+=("$state")
        keys+=("$key")
        paths+=("$path")
    done <"$manifest"
    for ((index=${#paths[@]} - 1; index >= 0; index--)); do
        state="${states[$index]}"
        key="${keys[$index]}"
        path="${paths[$index]}"
        case "$state" in
            present)
                if [ ! -e "$TRANSACTION_DIR/$key" ] \
                        && [ ! -L "$TRANSACTION_DIR/$key" ]; then
                    recovery_failed=1
                    continue
                fi
                ;;
            missing) ;;
            *) recovery_failed=1; continue ;;
        esac
        if ! rm -rf -- "$path"; then
            recovery_failed=1
            continue
        fi
        if [ "$state" = present ]; then
            recover_command mkdir -p -- "$(dirname "$path")"
            recover_command cp -a -- "$TRANSACTION_DIR/$key" "$path"
        fi
    done
}

restore_transaction_units() {
    local manifest="$TRANSACTION_DIR/units"
    local unit enabled active fragment unit_path unit_key mask_after
    [ -f "$manifest" ] || return 0
    recover_command systemctl --user daemon-reload >/dev/null 2>&1
    while IFS= read -r -d '' unit \
            && IFS= read -r -d '' enabled \
            && IFS= read -r -d '' active \
            && IFS= read -r -d '' fragment \
            && IFS= read -r -d '' unit_path; do
        if [[ ! $unit =~ ^[A-Za-z0-9][A-Za-z0-9@_.:-]*\.(service|timer)$ ]] \
                || [ "$unit_path" != "${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user/$unit" ] \
                || { [ "$active" != 0 ] && [ "$active" != 1 ]; }; then
            recovery_failed=1
            continue
        fi
        unit_key="unit-$unit"
        mask_after=""
        case "$enabled" in
            enabled|enabled-runtime|linked-runtime|masked|masked-runtime|disabled \
                    |static|indirect|generated|transient|not-found) ;;
            enabled-linked|enabled-runtime-linked|linked|alias)
                if [ ! -e "$TRANSACTION_DIR/$unit_key" ] \
                        && [ ! -L "$TRANSACTION_DIR/$unit_key" ]; then
                    recovery_failed=1
                    continue
                fi
                ;;
            *) recovery_failed=1; continue ;;
        esac
        if [ "$enabled" = linked-runtime ] && [ -z "$fragment" ]; then
            recovery_failed=1
            continue
        fi
        # systemd permits an already-running unit to be masked. Restore its
        # activity while unmasked, then recreate the persistent/runtime mask.
        recover_command systemctl --user unmask "$unit" >/dev/null 2>&1
        case "$enabled" in
            enabled|enabled-linked)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                if [ "$enabled" = enabled-linked ] \
                        || [ -L "$TRANSACTION_DIR/$unit_key" ]; then
                    recover_command rm -rf -- "$unit_path"
                    recover_command cp -a -- "$TRANSACTION_DIR/$unit_key" "$unit_path"
                    recover_command systemctl --user daemon-reload >/dev/null 2>&1
                fi
                recover_command systemctl --user enable "$unit" >/dev/null 2>&1
                ;;
            enabled-runtime|enabled-runtime-linked)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                if [ "$enabled" = enabled-runtime-linked ] \
                        || [ -L "$TRANSACTION_DIR/$unit_key" ]; then
                    recover_command rm -rf -- "$unit_path"
                    recover_command cp -a -- "$TRANSACTION_DIR/$unit_key" "$unit_path"
                    recover_command systemctl --user daemon-reload >/dev/null 2>&1
                fi
                recover_command systemctl --user enable --runtime "$unit" >/dev/null 2>&1
                ;;
            linked|alias)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                recover_command rm -rf -- "$unit_path"
                if [ -e "$TRANSACTION_DIR/$unit_key" ] \
                        || [ -L "$TRANSACTION_DIR/$unit_key" ]; then
                    recover_command cp -a -- "$TRANSACTION_DIR/$unit_key" "$unit_path"
                fi
                recover_command systemctl --user daemon-reload >/dev/null 2>&1
                ;;
            linked-runtime)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                [ -z "$fragment" ] \
                    || recover_command systemctl --user link --runtime "$fragment" >/dev/null 2>&1
                ;;
            masked)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                mask_after=persistent
                ;;
            masked-runtime)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                mask_after=runtime
                ;;
            disabled)
                recover_command systemctl --user disable "$unit" >/dev/null 2>&1
                ;;
            static|indirect|generated|transient|not-found)
                # These states come from the restored unit definition rather
                # than enablement links. In particular, do not disable an
                # indirect unit and mutate units named by Also=.
                ;;
            *) recovery_failed=1; continue ;;
        esac
        if [ "$active" = 1 ]; then
            recover_command systemctl --user start "$unit" >/dev/null 2>&1
        else
            recover_command systemctl --user stop "$unit" >/dev/null 2>&1
        fi
        case "$mask_after" in
            persistent) recover_command systemctl --user mask "$unit" >/dev/null 2>&1 ;;
            runtime) recover_command systemctl --user mask --runtime "$unit" >/dev/null 2>&1 ;;
        esac
    done <"$manifest"
}

# Refuse broad or unrelated deletion targets even if a caller is malformed.
if [ "$(basename "$SHELL_DIR")" != "nbshell" ] \
        || [ "$(dirname "$ROLLBACK_DIR")" != "$PARENT_DIR" ] \
        || [[ "$(basename "$ROLLBACK_DIR")" != .nbshell-rollback.* ]] \
        || [ "$PARENT_DIR" = "/" ]; then
    echo "Refusing unsafe nbshell recovery paths." >&2
    exit 2
fi
[ "$MODE" = restart ] || [ "$MODE" = deferred ] \
    || [ "$MODE" = manual ] || [ "$MODE" = inactive ] \
    || { echo "Unknown recovery mode: $MODE" >&2; exit 2; }
if [ -n "$TRANSACTION_DIR" ] && {
        [ "$(dirname "$TRANSACTION_DIR")" != "$(dirname "$PARENT_DIR")" ] \
        || [[ "$(basename "$TRANSACTION_DIR")" != .nbshell-install-rollback.* ]];
}; then
    echo "Refusing unsafe nbshell transaction path." >&2
    exit 2
fi
if [ -n "$STAGED_DIR" ]; then
    if [ "$(dirname "$STAGED_DIR")" != "$PARENT_DIR" ] \
            || [[ "$(basename "$STAGED_DIR")" != .nbshell-stage.* ]]; then
        printf 'Refusing unsafe nbshell staged path: %s\n' "$STAGED_DIR" >&2
        exit 2
    fi
fi

# A surviving transaction directory means the installer died before cleanup.
# Its committed marker is the durable boundary between a completed install and
# an interrupted one; unlike process-local traps this also covers SIGKILL.
if [ -d "$TRANSACTION_DIR" ] && [ -f "$TRANSACTION_DIR/committed" ]; then
    [ -z "$STAGED_DIR" ] || rm -rf -- "$STAGED_DIR"
    if [ "$MODE" != restart ] && [ -e "$SHELL_DIR" ]; then
        [ ! -d "$ROLLBACK_DIR" ] || rm -rf -- "$ROLLBACK_DIR"
        rm -rf -- "$TRANSACTION_DIR"
        exit 0
    fi
    rm -rf -- "$TRANSACTION_DIR"
fi
if [ -d "$TRANSACTION_DIR" ]; then
    set +e
    recovery_failed=0
    [ -z "$STAGED_DIR" ] || recover_command rm -rf -- "$STAGED_DIR"
    if [ "$MODE" = restart ]; then
        recover_command systemctl --user stop nbshell.service >/dev/null 2>&1
    fi
    restore_transaction_paths
    if [ -f "$TRANSACTION_DIR/original-runtime-present" ]; then
        if runtime_matches_original "$SHELL_DIR"; then
            # The installer died before the atomic exchange. The original is
            # still live; any occupied rollback name contains only the staged
            # replacement and must not be restored.
            :
        elif runtime_matches_original "$ROLLBACK_DIR"; then
            restore_runtime_from_backup || true
        elif [ ! -f "$TRANSACTION_DIR/original-runtime-identity" ] \
                && rollback_has_contents; then
            # Compatibility with transactions created before runtime identity
            # metadata was introduced.
            restore_runtime_from_backup || true
        else
            recovery_failed=1
        fi
    else
        recover_command rm -rf -- "$SHELL_DIR"
    fi
    restore_transaction_units
    if [ -f "$TRANSACTION_DIR/ytmusic-active" ]; then
        recover_command systemctl --user restart omarchy-ytmusic.service >/dev/null 2>&1
    fi
    if command -v update-desktop-database >/dev/null 2>&1; then
        recover_command update-desktop-database \
            "${XDG_DATA_HOME:-$HOME/.local/share}/applications" >/dev/null 2>&1
    fi
    if [ "$MODE" = restart ] && [ -d "$SHELL_DIR" ]; then
        recover_command systemctl --user start nbshell.service >/dev/null 2>&1
    elif [ "$MODE" = manual ] && [ -d "$SHELL_DIR" ]; then
        recover_command "$COMMAND_PATH" start -d >/dev/null 2>&1
    fi
    if [ $recovery_failed -eq 0 ]; then
        [ ! -d "$ROLLBACK_DIR" ] || rm -rf -- "$ROLLBACK_DIR"
        rm -rf -- "$TRANSACTION_DIR"
        exit 0
    fi
    echo "nbshell recovery was incomplete; backups remain in $TRANSACTION_DIR" >&2
    exit 1
fi

discard_empty_reservation

if [ "$MODE" = deferred ] || [ "$MODE" = inactive ] || [ "$MODE" = manual ]; then
    if [ ! -e "$SHELL_DIR" ] && rollback_is_runtime; then
        mv -T -- "$ROLLBACK_DIR" "$SHELL_DIR"
    fi
    if [ "$MODE" = manual ] && [ -d "$SHELL_DIR" ]; then
        "$COMMAND_PATH" start -d >/dev/null 2>&1 || true
    fi
    exit 0
fi

if ! systemctl --user is-active --quiet nbshell.service; then
    systemctl --user start nbshell.service >/dev/null 2>&1 || true
    sleep 2
fi

if systemctl --user is-active --quiet nbshell.service; then
    [ ! -d "$ROLLBACK_DIR" ] || rm -rf -- "$ROLLBACK_DIR"
    exit 0
fi

if ! rollback_is_runtime; then
    echo "nbshell could not restart and no rollback runtime is available." >&2
    exit 1
fi

systemctl --user stop nbshell.service >/dev/null 2>&1 || true
[ ! -e "$SHELL_DIR" ] || rm -rf -- "$SHELL_DIR"
mv -T -- "$ROLLBACK_DIR" "$SHELL_DIR"
systemctl --user start nbshell.service

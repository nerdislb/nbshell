// Minimal compositor session for the native Orbital greetd frontend.
spawn-sh-at-startup "/usr/bin/quickshell -p /usr/local/share/nbshell/greeter; niri msg action quit --skip-confirmation"

hotkey-overlay {
    skip-at-startup
}

environment {
    XDG_SESSION_TYPE "wayland"
    XDG_CURRENT_DESKTOP "nbshell-greeter"
}

input {
    keyboard {
        xkb {
            layout "de"
        }
        numlock
    }
    touchpad {
        tap
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

layout {
    background-color "#1a1b26"
}

window-rule {
    match app-id=r#"^(regreet|dev\.nerdi\.nbshell\.greeter)$"#
    open-maximized true
}

debug {
    honor-xdg-activation-with-invalid-serial
}
